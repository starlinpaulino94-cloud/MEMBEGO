{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "build": {
    "env": {
      "SENTRY_UPLOAD": "off"
    }
  },
  "crons": [
    {
      "path": "/api/cron/automatizaciones",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/renovaciones-tarjeta",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/integraciones",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/supply",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/supply-v2",
      "schedule": "0 6 * * *"
    }
  ]
}
