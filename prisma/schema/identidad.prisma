// ──────────────────────────────────────────────────────────────────────────
// IDENTIDAD, EMPRESAS Y AUDITORÍA
//
// Quién es quién y a qué empresa pertenece. `User.supabaseId` apunta al
// esquema `auth` de Supabase, que Prisma NO gestiona — ver
// docs/RECUPERACION.md § 2.1: un volcado de `public` no trae credenciales.
// ──────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppRole {
  SUPERADMIN
  ADMIN_EMPRESA // legacy: admin de empresa (se mantiene por usuarios existentes)
  EMPLEADO
  CLIENTE
  // Roles de equipo de empresa (deben coincidir con AppRole en src/types).
  ADMINISTRADOR
  GERENTE
  CAJERO
  RECEPCION
  MARKETING // difusión: promociones, campañas, publicaciones, audiencia, notificaciones
  SUPERVISOR // operación: dashboard/reportes, clientes, validar pagos, scanner
  /// Vendedor de Excursiones: solo alcanza /vendedor. Es un rol de ACCESO
  /// EXTERNO (hoteles, taxistas, promotores) y por eso no está en ningún grupo
  /// de administración ni del escáner: su aislamiento es estructural, no una
  /// configuración de permisos que alguien pueda equivocarse al poner.
  VENDEDOR
}

enum NotifTipo {
  PAGO_APROBADO
  PAGO_RECHAZADO
  NUEVO_COMPROBANTE
  MEMBRESIA_POR_VENCER
  MEMBRESIA_ACTIVADA
  PROMOCION_NUEVA
  RECOMPENSA_REFERIDO
  SISTEMA
  TICKET_NUEVO
  TICKET_RESPUESTA
  TICKET_ACTUALIZADO
  // Módulo de Citas.
  CITA_NUEVA
  CITA_CONFIRMADA
  CITA_CANCELADA
}

enum AuditAccion {
  VISITA_CONFIRMADA
  /// Una visita ya registrada se deshizo y el lavado volvió al saldo del
  /// cliente. Va aparte de VISITA_CONFIRMADA porque se pregunta por ella sola:
  /// «¿por qué a este cliente le sobra un lavado?».
  VISITA_REVERTIDA
  PAGO_APROBADO
  PAGO_RECHAZADO
  MEMBRESIA_CANCELADA
  /// Un superadmin la caducó A MANO (pasa a VENCIDA). NO es cancelar: la
  /// membresía termina su ciclo antes de tiempo en vez de darse por terminada.
  /// Compartían etiqueta y la bitácora llamaba «cancelada» a las dos.
  MEMBRESIA_DESACTIVADA
  MEMBRESIA_RENOVADA
  /// Una membresía SIN historial se borró de verdad (no se canceló). Solo
  /// puede pasar cuando no tenía visitas, comprobantes ni pagos confirmados
  /// —o sea, cuando nunca llegó a usarse—, así que este asiento es el único
  /// rastro que queda de que existió.
  MEMBRESIA_ELIMINADA
  QR_GENERADO
  QR_USADO
  QR_COMPARTIDO
  CAJA_ABIERTA
  CAJA_CERRADA
  CAJA_MOVIMIENTO
  COBRO_REGISTRADO
  COMPROBANTE_IMPRESO
  TRANSACCION_ANULADA
  REFERIDO_COMPLETADO
  RECOMPENSA_OTORGADA
  NOTA_INTERNA
  PLANTILLA_RECIBO_ACTUALIZADA
  CUENTA_ELIMINADA
  /// Una empresa pasó a ser (o dejó de ser) de demostración.
  EMPRESA_DEMO_CAMBIADA
  /// Se borraron los datos de práctica de una empresa de demostración.
  EMPRESA_DEMO_REINICIADA
  /// Un usuario recibió el rango de superadmin.
  SUPERADMIN_OTORGADO
  /// A un usuario se le retiró el rango de superadmin.
  SUPERADMIN_RETIRADO
  /// El superadmin generó un enlace para entrar como otro usuario.
  ENTRAR_COMO_GENERADO
  /// Alguien ABRIÓ ese enlace y la sesión de la otra persona quedó activa.
  /// Es el registro que importa: `ENTRAR_COMO_GENERADO` solo prueba que se
  /// preparó el enlace, y a partir de aquí todo lo que se haga queda en la
  /// bitácora a nombre del suplantado.
  ENTRAR_COMO_USADO
  // Módulo de Geolocalización (docs/GEOLOCALIZACION.md).
  /// La persona guardó/actualizó una ubicación declarada (CustomerLocation).
  UBICACION_GUARDADA
  /// La persona eliminó una de sus ubicaciones declaradas.
  UBICACION_ELIMINADA
  /// La persona otorgó un consentimiento de ubicación (GeoConsent).
  CONSENTIMIENTO_GEO_OTORGADO
  /// La persona revocó un consentimiento de ubicación.
  CONSENTIMIENTO_GEO_REVOCADO
  /// El admin de empresa guardó/actualizó la geolocalización de una sucursal.
  SUCURSAL_UBICACION_GUARDADA
  /// El admin verificó visualmente las coordenadas de una sucursal.
  SUCURSAL_UBICACION_VERIFICADA
  /// El superadmin aprobó un sector/ciudad del catálogo propuesto por un usuario.
  CATALOGO_GEO_APROBADO
  // Catálogo de planes. Es lo que los clientes COMPRAN: sin estas cuatro no
  // hay forma de saber cuánto costaba un plan el mes pasado ni quién lo cambió.
  /// Se creó un plan.
  PLAN_CREADO
  /// Se editó un plan (el payload lleva el precio anterior y el nuevo).
  PLAN_ACTUALIZADO
  /// El plan dejó de ofrecerse (las membresías ya vendidas no se tocan).
  PLAN_PAUSADO
  /// El plan volvió a ofrecerse.
  PLAN_REANUDADO
  /// Se eliminó un plan.
  PLAN_ELIMINADO
  /// El superadmin cambió los módulos encendidos de una empresa. Iba como
  /// `NOTA_INTERNA` con un subtipo, así que no se podía filtrar por acción — y
  /// es lo que decide a qué secciones entra un negocio.
  CAPACIDADES_ACTUALIZADAS
  /// Se creó una promoción. Existe por el reparto de las campañas conjuntas:
  /// crea filas reales en empresas ajenas y no dejaba ni una línea.
  PROMOCION_CREADA
  /// Campañas conjuntas: el reparto a las empresas participantes.
  CAMPANA_APLICADA
  /// Se archivó una campaña, y con ella se DESACTIVÓ lo que generó en todas
  /// las empresas. No se auditaba en absoluto.
  CAMPANA_ARCHIVADA
  // Integraciones con sistemas satélite. Las tres acciones del panel tocan
  // sistemas de TERCEROS —salen peticiones a su dominio y se mueve la cola de
  // eventos de todas las empresas— y no dejaban ni una línea: si alguien
  // reencolaba mil eventos un martes, no había forma de saber quién ni cuándo.
  /// Se probó el webhook de un sistema conectado (payload: código y veredicto).
  INTEGRACION_SONDEADA
  /// Se forzó el reenvío de la cola pendiente de un sistema, sin esperar al cron.
  INTEGRACION_REINTENTADA
  /// Se devolvieron a la cola los eventos que habían agotado sus intentos.
  INTEGRACION_REENCOLADA
  // Cola de trabajos (Membego Connect · Fase 2): decisiones del superadmin
  // sobre los trabajos difuntos. Reencolar re-ejecuta un trabajo con efectos
  // reales (notificaciones, correos) y descartar renuncia a él para siempre —
  // ninguna de las dos puede quedar sin nombre y sin fecha.
  /// Se devolvió a la cola un trabajo que había agotado sus reintentos.
  COLA_REENCOLADA
  /// Se descartó definitivamente un trabajo difunto.
  COLA_DESCARTADA
  /// Home comercial (F2): se guardó un borrador de la composición del Inicio.
  COMPOSICION_GUARDADA
  /// Se publicó (o programó) la composición del Inicio.
  COMPOSICION_PUBLICADA
  /// Se pausó la composición publicada: el Inicio vuelve al contenido base.
  COMPOSICION_PAUSADA
  /// Se archivó una revisión (historial, sin efecto visible).
  COMPOSICION_ARCHIVADA
  // Membego Connect (Fase 9): lo que el superadmin concede y administra.
  // Conceder claves de API a una empresa le abre sus datos a terceros: es una
  // decisión comercial con consecuencias de seguridad y no puede quedar sin
  // nombre y sin fecha.
  /// Se concedió o ajustó un límite de Connect a una empresa.
  CONNECT_CONCEDIDO
  /// Se cambió el estado de un conector del catálogo.
  CONNECT_CONECTOR_ESTADO
  /// Se evaluó un segmento de audiencia (auditoría de la estimación).
  SEGMENTO_EVALUADO
  /// Se envió una campaña dirigida a un segmento.
  CAMPANA_DIRIGIDA_ENVIADA
  // ── Membego Supply (docs/membego-supply-architecture.md · Fase 43) ────────
  // Aquí se compromete el capital de la plataforma con empresas de terceros.
  // Cada una de estas acciones mueve dinero, supply o el derecho de una
  // persona a recibir algo, y ninguna puede quedar sin nombre y sin fecha.
  /// Se creó un acuerdo de supply con un proveedor.
  SUPPLY_ACUERDO_CREADO
  /// Un acuerdo cambió de estado (aprobado, activado, cancelado).
  SUPPLY_ACUERDO_ESTADO
  /// Se enmendó un contrato ya firmado (cantidad, vigencia, capacidad…).
  SUPPLY_ENMIENDA_REGISTRADA
  /// Se creó una orden de compra de supply.
  SUPPLY_ORDEN_CREADA
  /// Una orden de compra cambió de estado. Incluye la APROBACIÓN, que es el
  /// momento en que la plataforma se compromete financieramente.
  SUPPLY_ORDEN_ESTADO
  /// Se activó un lote: los derechos comprados entran al pool.
  SUPPLY_LOTE_ACTIVADO
  /// Se apartaron unidades para una campaña o destino.
  SUPPLY_ASIGNACION_CREADA
  /// Se devolvieron al pool unidades apartadas.
  SUPPLY_ASIGNACION_LIBERADA
  /// Se emitió un derecho a un cliente.
  SUPPLY_DERECHO_EMITIDO
  /// Se canceló o revocó un derecho ya emitido.
  SUPPLY_DERECHO_CANCELADO
  /// Se generó un voucher (o se reemitió).
  SUPPLY_VOUCHER_EMITIDO
  /// El comercio entregó la unidad.
  SUPPLY_REDENCION_REGISTRADA
  /// Se deshizo una entrega. La operación original NO se borra.
  SUPPLY_REDENCION_REVERSADA
  /// Se abrió una incidencia de cumplimiento.
  SUPPLY_INCIDENCIA_ABIERTA
  /// Se resolvió una disputa.
  SUPPLY_INCIDENCIA_RESUELTA
  /// Se registró un pago a un proveedor.
  SUPPLY_PAGO_REGISTRADO
  /// Se confirmó un pago y se asentó en el ledger financiero.
  SUPPLY_PAGO_CONFIRMADO
  /// Se corrigió el ledger de un lote con un ajuste manual.
  SUPPLY_AJUSTE_LEDGER
  /// Se recalcularon los contadores de un lote desde el ledger.
  SUPPLY_LOTE_RECALCULADO
  // ── CRM · prospectos y respuestas automáticas (24-09-2026) ───────────────
  // El CRM no escribía NI UNA línea de bitácora. Se destapó investigando si
  // alguien había pasado por el hueco de permisos que tenían estas mismas
  // actions, y la respuesta fue que no se podía saber: ni auditoría, ni
  // columna de autor en `Lead` ni en `AutoReplyConfig`. Un prospecto es un
  // cliente potencial con su teléfono y su correo, y descartarlo o
  // reasignarlo le quita trabajo —y comisión— a alguien: no puede seguir
  // pasando sin nombre y sin fecha.
  /// Se creó un prospecto.
  PROSPECTO_CREADO
  /// Se editó un prospecto (el payload lleva solo los campos que cambiaron).
  PROSPECTO_ACTUALIZADO
  /// Se descartó un prospecto. Es un borrado blando: la fila sigue ahí en
  /// estado DESCARTADO, así que este asiento es lo único que dice quién lo
  /// sacó del embudo y cuándo.
  PROSPECTO_DESCARTADO
  /// Un prospecto cambió de etapa del embudo (el payload lleva de dónde a
  /// dónde). Va aparte de PROSPECTO_ACTUALIZADO porque es la pregunta que se
  /// hace sola: «¿quién dio este trato por perdido?».
  PROSPECTO_ETAPA_CAMBIADA
  /// Un prospecto se asignó a otra persona (o se dejó sin asignar).
  PROSPECTO_ASIGNADO
  /// Se creó una respuesta automática. Contesta en nombre de la empresa a
  /// quien escribe por WhatsApp o redes: cambiarla cambia lo que el negocio
  /// le dice a sus clientes sin que nadie lo lea antes.
  AUTO_RESPUESTA_CREADA
  /// Se editó una respuesta automática.
  AUTO_RESPUESTA_ACTUALIZADA
  /// Se eliminó una respuesta automática.
  AUTO_RESPUESTA_ELIMINADA
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id                         String    @id @default(cuid())
  supabaseId                 String    @unique
  establecerContrasenaToken  String?
  establecerContrasenaExpira DateTime? @db.Timestamptz()
  email                      String    @unique
  name                       String

  /// Copia del nombre sin acentos y en minúsculas, SOLO para buscar. La
  /// mantiene un disparador en la base: la aplicación nunca la escribe, así
  /// que no puede quedarse desfasada porque alguien olvidara actualizarla.
  nombreBusqueda     String?
  role               AppRole   @default(CLIENTE)
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id])
  /// Módulo de PERMISOS: ajustes por empleado sobre lo que su rol trae de
  /// serie ({v:1, secciones:{sec:bool}, funciones:{sec:{fn:false}}}). Solo
  /// diferencias; null = hereda el rol tal cual. Ver lib/auth/permissions.ts.
  permisos           Json?
  /// Reportes: qué cifras del resumen ejecutivo ve ESTA persona y en qué orden
  /// ({v:1, ocultas:[clave], orden:[clave]}). Se guarda lo OCULTO, no lo
  /// visible: así una cifra nueva aparece sola para todos en vez de quedar
  /// escondida para quien hubiera personalizado alguna vez. null = de fábrica.
  /// Ver modules/reportes/preferencias.ts.
  preferenciasReportes Json?
  // Consentimiento (cumplimiento): rastro auditable de aceptación de términos
  // y opt-in de comunicaciones de marketing, con la versión y el momento.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships      Membership[]
  eventosMembresia MembresiaEvento[]   @relation("EventosMembresia")
  visits           Visit[]             @relation("EmpleadoVisits")
  /// Visitas que ESTE usuario deshizo. Va aparte de `visits`: quien registra un
  /// lavado y quien lo devuelve rara vez son la misma persona.
  visitsRevertidas Visit[]             @relation("VisitsRevertidas")
  auditLogs        AuditLog[]
  comprobantes     Comprobante[]
  notificaciones   Notificacion[]
  follows          CompanyFollow[]
  promosGuardadas  PromocionGuardada[]
  notasCliente     ClienteNota[]
  intereses        UserInteres[]
  empresasAcceso   UserCompanyAccess[]
  /// Acceso a los sistemas verticales, con su rol DENTRO de cada uno.
  sistemasAcceso   UsuarioSistema[]

  // Geolocalización (G-1): la ubicación es de la PERSONA, cross-empresa.
  customerLocations CustomerLocation[]
  geoConsents       GeoConsent[]

  // Listados de empleados por empresa (/admin/empleados) y conteos por empresa.
  transaccionesComoEmpleado   Transaction[]              @relation("TransactionEmpleado")
  cajasAbiertas               CajaSesion[]               @relation("CajaAbiertaPor")
  cajasCerradas               CajaSesion[]               @relation("CajaCerradaPor")
  transicionesTransaccion     TransactionTransicion[]
  impresionesRecibo           ReceiptImpresion[]
  citasAtendidas              Cita[]                     @relation("CitaAtendidaPor")
  ofertasCreadas              OfertaPrivada[]            @relation("OfertaCreadaPor")
  ofertaUsosRegistrados       OfertaUso[]                @relation("OfertaUsoRegistradoPor")
  comprasAprobadas            ProductoCompra[]           @relation("CompraAprobadaPor")
  transicionesCompra          ProductoCompraTransicion[]
  // App Car Wash · E5.
  colaRegistrada              ColaVehiculo[]             @relation("ColaRegistradaPor")
  colaAtendida                ColaVehiculo[]             @relation("ColaAtendidaPor")
  campanasGlobales            CampanaGlobal[]            @relation("CampanaGlobalCreadaPor")
  movimientosInventario       MovimientoInventario[]     @relation("MovInventarioPor")
  evidenciasSubidas           EvidenciaFoto[]            @relation("EvidenciaSubidaPor")
  // App Car Wash · Fase 2.
  comisiones                  Comision[]                 @relation("ComisionLavador")
  incidenciasReportadas       Incidencia[]               @relation("IncidenciaReportadaPor")
  incidenciasAsignadas        Incidencia[]               @relation("IncidenciaResponsable")
  // App Car Wash · Fase 3.
  ordenesCompra               OrdenCompra[]              @relation("OrdenCompraCreadaPor")
  mantenimientos              Mantenimiento[]            @relation("MantenimientoPor")
  turnos                      Turno[]                    @relation("TurnoEmpleado")
  turnosCerrados              Turno[]                    @relation("TurnoCerradoPor")
  // ── Membego Supply ────────────────────────────────────────────────────────
  supplyAcuerdosCreados       SupplyAcuerdo[]            @relation("SupplyAcuerdoCreadoPor")
  supplyAcuerdosAprobados     SupplyAcuerdo[]            @relation("SupplyAcuerdoAprobadoPor")
  supplyEnmiendasSolicitadas  SupplyEnmienda[]           @relation("SupplyEnmiendaSolicitadaPor")
  supplyEnmiendasAprobadas    SupplyEnmienda[]           @relation("SupplyEnmiendaAprobadaPor")
  supplyOrdenesCreadas        SupplyOrden[]              @relation("SupplyOrdenCreadaPor")
  supplyOrdenesAprobadas      SupplyOrden[]              @relation("SupplyOrdenAprobadaPor")
  supplyMovimientos           SupplyMovimiento[]         @relation("SupplyMovimientoActor")
  supplyAsignacionesCreadas   SupplyAsignacion[]         @relation("SupplyAsignacionCreadaPor")
  supplyQrConsumidos          SupplyQrSesion[]           @relation("SupplyQrConsumidoPor")
  supplyRedencionesEntregadas SupplyRedencion[]          @relation("SupplyRedencionEmpleado")
  supplyRedencionesReversadas SupplyRedencion[]          @relation("SupplyRedencionReversadaPor")
  supplyIncidenciasReportadas SupplyIncidencia[]         @relation("SupplyIncidenciaReportadaPor")
  supplyIncidenciasResueltas  SupplyIncidencia[]         @relation("SupplyIncidenciaResueltaPor")
  supplyPagosRegistrados      SupplyPago[]               @relation("SupplyPagoRegistradoPor")
  supplyAsientosFinancieros   SupplyAsientoFinanciero[]  @relation("SupplyAsientoActor")

  @@index([companyId])
  @@index([nombreBusqueda(ops: raw("gin_trgm_ops"))], map: "users_nombre_busqueda_trgm", type: Gin)
  @@map("users")
}

/// Acceso multi-empresa para usuarios de staff: un mismo administrador puede
/// gestionar VARIAS empresas. `User.companyId` sigue siendo la empresa ACTIVA
/// (la que ve en su panel); esta tabla define a cuáles puede cambiar.
model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_company_access")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String // "carwash" | "restaurante"
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  email     String?
  telefono  String?
  direccion String?
  ciudad    String?
  categoria String?
  website   String?

  /// EMPRESA DE DEMOSTRACIÓN: existe para entrenar al personal, no para
  /// operar. Todo lo que ocurre dentro es de mentira — sus clientes, sus
  /// cobros y sus números. Ver `src/modules/demo/index.ts`: esa marca es la
  /// que corta la pasarela de pago real, los correos salientes, la vitrina
  /// pública y las métricas de la plataforma.
  esDemo Boolean @default(false)

  // FASE 2: Marketplace fields
  isPublished           Boolean  @default(true)
  isFeatured            Boolean  @default(false)
  featuredOrder         Int?
  bannerUrl             String?
  galleryImages         String[] @default([])
  provincia             String?
  pais                  String?
  // F5/Onboarding: datos legales y de ubicación precisa (paso 2-3 del wizard).
  razonSocial           String?
  codigoPostal          String?
  latitud               Float?
  longitud              Float?
  zonaCobertura         String? // texto libre: barrios/zonas atendidas o radio
  // F5/Onboarding paso 4: configuración regional y de marca. Preferencia por
  // empresa aplicada al FORMATEAR (moneda/fecha); no traduce la UI ni convierte
  // divisas (Decisión 4 del plan de onboarding).
  moneda                String   @default("DOP") // ISO 4217: DOP, USD, EUR…
  zonaHoraria           String   @default("America/Santo_Domingo") // IANA
  idioma                String   @default("es-DO") // locale BCP 47
  // Fase E7: método de escaneo predeterminado del escáner ("camara" | "lector").
  // El operador puede cambiarlo en pantalla sin recargar; esto es solo el valor
  // inicial que la empresa configura.
  escanerModo           String   @default("camara")
  colorPrimario         String? // hex de marca, ej. "#0ea5e9"
  // Engagement Engine · Fase 7: personalización del motor por empresa.
  // JSON: { color?, gamificacion?, pruebaSocial?, campanas?, carruseles? }.
  // Ausente/null = todo activado y color = colorPrimario.
  engagementConfig      Json?
  politicaCancelacion   String?
  politicaPrivacidad    String?
  terminosEmpresa       String?
  whatsapp              String?
  instagram             String?
  facebook              String?
  tiktok                String?
  googleMapsUrl         String?
  // F4.1: horario de atención mostrado en el perfil público (texto libre,
  // ej. "Lun-Vie 8:00-18:00 · Sáb 9:00-14:00").
  horario               String?
  totalMembersCount     Int      @default(0)
  activePromotionsCount Int      @default(0)
  averageRating         Decimal? @db.Decimal(3, 2)

  // O-13: beneficio de bienvenida financiado por la EMPRESA (opt-in). Se
  // aplica UNA sola vez, en la primera activación de membresía del cliente
  // en esta empresa. PORCENTAJE = % sobre el precio del plan; MONTO = importe
  // fijo (nunca supera el precio del plan).
  bienvenidaActiva Boolean  @default(false)
  bienvenidaTipo   String   @default("PORCENTAJE") // PORCENTAJE | MONTO
  bienvenidaValor  Decimal? @db.Decimal(10, 2)

  // Regalos P2P (docs/REGALOS-P2P.md §3.4). JSON: { permitirTransferencias?,
  // permitirRegalos?, maxTransferenciasMes?, vigenciaHoras? }. null = defaults.
  regalosConfig Json?

  // Plataforma modular (docs/ESTRATEGIA-PLATAFORMA.md · E1). JSON:
  // { categoria?, overrides?: { CAPACIDAD: boolean } }. null = paquete base
  // de su categoría (fail-open: nada de lo actual desaparece).
  capacidades Json?

  /// Vertical de la empresa, como CÓDIGO de `tipos_negocio` (Fase 7).
  ///
  /// ────────────────────────────────────────────────────────────────────────
  /// QUÉ ESTABA ROTO SIN ESTO
  ///
  /// El vertical de una empresa salía de `categoriaDeType(type)`: un `switch`
  /// de cuatro casos con `default: 'CAR_WASH'`. La Fase 1b convirtió los tipos
  /// de negocio en TABLA para que registrar un vertical nuevo fuera escribir
  /// filas — pero la COMPATIBILIDAD seguía decidiéndose contra esa lista
  /// congelada.
  ///
  /// El resultado: se podía dar de alta el sistema de un hotel y ninguna
  /// empresa podía ser compatible con él jamás, porque el vertical de una
  /// empresa solo sabía tomar cuatro valores. El registro era datos; la
  /// compatibilidad seguía siendo código.
  ///
  /// Lo encontró la prueba contra base real de la Fase 7: una empresa creada
  /// con `type: "restaurant"` caía en el `default` y quedaba clasificada como
  /// lavadero.
  ///
  /// Nullable y RELLENADA con la resolución de siempre, así que ninguna empresa
  /// cambia de vertical el día del despliegue. Cuando está, manda; cuando no,
  /// se resuelve como antes.
  tipoNegocioCodigo String?

  // Seguimiento de beneficios gratis (docs/SEGUIMIENTO-BENEFICIOS.md · S3).
  // JSON: { umbralPorVencerDias?, recordatorioAuto?, recordatorioDiasAntes?,
  // recordatorioFrecuenciaDias?, plantillaMensaje?, promosExcluidas? }.
  // null = defaults del módulo.
  seguimientoConfig Json?

  /// Umbrales del SEMÁFORO DEL CLIENTE (docs/auditoria-clientes-membresias.md
  /// · bloque 3): cuántos días sin venir lo ponen en riesgo, cuántos lo dan por
  /// dormido, cuántos por perdido. Configurables porque un car wash y un
  /// restaurante no tienen la misma frecuencia normal de visita: treinta días
  /// sin lavar el carro es raro; treinta días sin cenar fuera, no.
  /// null = los valores por defecto (ver `modules/riesgo/semaforo.ts`).
  retencionConfig Json?

  users                  User[]
  plans                  Plan[]
  clientes               Cliente[]
  memberships            Membership[]
  membresiaEventos       MembresiaEvento[]
  tarjetasTokenizadas    TarjetaTokenizada[]
  sucursales             Sucursal[]
  cajaSesiones           CajaSesion[]
  metodosPago            MetodoPago[]
  auditLogs              AuditLog[]
  promociones            Promocion[]
  referidos              Referido[]
  reglasRecompensa       ReglaRecompensa[]
  whatsappConfig         WhatsAppConfig?
  faqs                   FaqItem[]
  tickets                SupportTicket[]
  categories             CompanyToCategory[]
  ratings                CompanyRating[]
  referralEvents         ReferralEvent[]
  followers              CompanyFollow[]
  posts                  CompanyPost[]
  campanas               Campana[]
  invitaciones           Invitacion[]
  accesosStaff           UserCompanyAccess[]
  // Benefit Engine (Fase C). Relaciones inversas; ningún flujo las consume aún.
  benefits               Benefit[]
  // Referral Engine (Fase D). Relaciones inversas; ningún flujo las consume aún.
  referralPrograms       ReferralProgram[]
  // Automation Engine (Fase E1). Relaciones inversas; ningún flujo las consume aún.
  automations            Automation[]
  // Motor Universal de Reglas (Fase 1). Relaciones inversas; no cambian el
  // comportamiento actual: ninguna función existente las consulta todavía.
  ruleGroups             RuleGroup[]
  rules                  Rule[]
  ruleExecLogs           RuleExecutionLog[]
  // Framework Universal de Promociones (Fase 4). Relaciones inversas; ningún
  // flujo existente las consulta.
  promotions             Promotion[]
  promotionAudits        PromotionAudit[]
  // Business Data Dictionary (Fase 6). Variables específicas de empresa.
  dictionaryVariables    DataDictionaryVariable[]
  // Membership Engine universal (Fase A). Independiente del modelo Membership
  // legacy (Car Wash). Ningún flujo existente lo consulta.
  membershipPlans        MembershipPlan[]
  membershipInstances    MembershipInstance[]
  // Benefit Transformation Engine (Fase E1.7).
  benefitTransformations BenefitTransformation[]
  transformationPolicies TransformationPolicy[]

  transacciones      Transaction[]
  receiptTemplate    ReceiptTemplate?
  compras            ProductoCompra[]
  // Growth Engine: Campañas de Invitación ("Invita y Gana").
  campanasInvitacion CampanaInvitacion[]

  // Growth Engine 3.0 (sistema viral de referidos).
  growthLinks  GrowthLink[]
  growthConfig GrowthConfig?
  growthRules  GrowthRule[]

  // Engagement Engine · Fase 2 (Motor de Campañas de marketing).
  marketingCampaigns MarketingCampaign[]
  // Engagement Engine · Fase 6B (Ruleta de premios).
  ruletaPremios      RuletaPremio[]
  ruletaJugadas      RuletaJugada[]

  // Geolocalización: constructor de audiencias y campañas dirigidas.
  savedSegments     SavedSegment[]
  campanasDirigidas CampanaDirigida[]

  // Módulo de Citas.
  agendaConfig      AgendaConfig?
  citas             Cita[]
  // Home comercial (F2): revisiones de composición y sinónimos de búsqueda.
  homeRevisiones    HomeRevision[]
  busquedaSinonimos BusquedaSinonimo[]
  ofertaPrivadas    OfertaPrivada[]
  regalos           Regalo[]
  giftCards         GiftCard[]

  // App Car Wash · E5.
  colaVehiculos         ColaVehiculo[]
  productosInventario   ProductoInventario[]
  evidenciasFoto        EvidenciaFoto[]
  campanaGlobalEmpresas CampanaGlobalEmpresa[]
  campanaPasos          CampanaPaso[]
  tipoVehiculos         TipoVehiculo[]
  servicios             Servicio[]
  bahias                Bahia[]
  pagoIntentos          PagoIntento[]
  cuentasCorporativas   CuentaCorporativa[]
  comisiones            Comision[]
  incidencias           Incidencia[]
  proveedores           Proveedor[]
  ordenesCompra         OrdenCompra[]
  activos               Activo[]
  turnos                Turno[]

  // ── Membego Supply (docs/membego-supply-architecture.md) ──────────────────
  // La MISMA organización es comercio y proveedora de Membego cuando tiene la
  // capacidad MEMBEGO_SUPPLIER encendida. No hay una segunda empresa.
  supplyAcuerdos    SupplyAcuerdo[]           @relation("SupplyProveedorAcuerdos")
  supplyOrdenes     SupplyOrden[]             @relation("SupplyProveedorOrdenes")
  supplyLotes       SupplyLote[]              @relation("SupplyProveedorLotes")
  supplyDerechos    SupplyDerecho[]           @relation("SupplyProveedorDerechos")
  supplyVouchers    SupplyVoucher[]           @relation("SupplyProveedorVouchers")
  supplyReservas    SupplyReserva[]           @relation("SupplyProveedorReservas")
  supplyRedenciones SupplyRedencion[]         @relation("SupplyProveedorRedenciones")
  supplyIncidencias SupplyIncidencia[]        @relation("SupplyProveedorIncidencias")
  supplyPagos       SupplyPago[]              @relation("SupplyProveedorPagos")
  supplyAsientos    SupplyAsientoFinanciero[] @relation("SupplyProveedorAsientos")

  @@index([isPublished, isFeatured])
  @@index([ciudad, provincia])
  @@index([type])
  @@index([tipoNegocioCodigo])
  @@index([createdAt])
  @@map("companies")
}

// Sucursales físicas de una empresa
model Sucursal {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  nombre    String
  direccion String?
  telefono  String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  visits Visit[]

  transacciones Transaction[]

  cajaSesiones    CajaSesion[]
  membershipsPago Membership[]     @relation("MembershipSucursalPago")
  comprasPago     ProductoCompra[] @relation("CompraSucursalPago")
  citas           Cita[]
  colaVehiculos   ColaVehiculo[]
  bahias          Bahia[]

  // Membego Supply: dónde se recoge y dónde se entrega.
  supplyReservas    SupplyReserva[]   @relation("SupplyReservaSucursal")
  supplyRedenciones SupplyRedencion[] @relation("SupplyRedencionSucursal")

  // ── Geolocalización (docs/GEOLOCALIZACION.md §3.3) ─────────────────────────
  // Normalizado: las claves del catálogo geo cuando la dirección se resuelve.
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  cityId      String?
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  sectorId    String?
  sector      Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  // Textos originales como respaldo (regla §30).
  ciudadTexto String?
  sectorTexto String?
  latitud     Float?
  longitud    Float?
  // PostGIS (G-4): columna `geography` sincronizada por trigger (§6), no la
  // gestiona Prisma.

  // Publicación en el mapa y radio de servicio.
  mostrarEnMapa          Boolean   @default(true)
  radioServicioKm        Int? // radio de atención (segmentación por radio, §25)
  ubicacionVerificada    Boolean   @default(false) // coordenadas validadas visualmente por el admin (§8)
  ubicacionActualizadaAt DateTime?
  /// Horario estructurado (amplía el texto libre de Company.horario).
  horarioDetallado       Json?

  // Campañas geosegmentadas por radio alrededor de esta sucursal.
  campanasDirigidas CampanaDirigida[]

  @@index([companyId])
  @@index([companyId, activa, mostrarEnMapa])
  @@index([cityId])
  @@index([sectorId])
  @@map("sucursales")
}

// Registro de auditoría inmutable — insert only, nunca se actualiza ni elimina
model AuditLog {
  id          String      @id @default(cuid())
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  userId      String? // quien realizó la acción
  user        User?       @relation(fields: [userId], references: [id])
  accion      AuditAccion
  entidadTipo String // "Visit", "Membership", "QrToken", etc.
  entidadId   String
  payload     Json        @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([accion])
  @@index([entidadTipo, entidadId])
  @@index([createdAt])
  /// El reporte de operación cuenta los QR generados y usados de una empresa
  /// entre dos fechas. Con los índices sueltos, Postgres elige uno de los tres
  /// y descarta el resto leyendo filas: sobre una bitácora que recibe varias
  /// entradas por cada escaneo, eso es la tabla entera. El compuesto resuelve
  /// las tres condiciones de una pasada.
  @@index([companyId, accion, createdAt])
  @@map("audit_logs")
}

model Notificacion {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tipo      NotifTipo
  titulo    String
  mensaje   String
  href      String? // ruta a la que lleva al hacer clic
  leida     Boolean   @default(false)
  createdAt DateTime  @default(now())
  /// Identidad estable del evento de origen (P1B): `origen:compañía:tipo:lote`.
  /// Con ella `skipDuplicates` sí deduplica reintentos; sin unicidad no hacía
  /// nada. NULL = histórico previo a la deduplicación (Postgres permite
  /// varios NULL en índice único: no se altera el pasado).
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, leida])
  @@index([userId, createdAt])
  @@map("notificaciones")
}
