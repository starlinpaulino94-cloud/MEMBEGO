// ──────────────────────────────────────────────────────────────────────────
// MEMBEGO SUPPLY · inventario patrocinado  (docs/membego-supply-architecture.md)
//
// Cuando Membego compra 1.000 pizzas a una pizzería NO adquiere 1.000 pizzas:
// adquiere 1.000 DERECHOS DE CONSUMO que el proveedor está obligado a cumplir
// cuando exista una redención válida. Por eso aquí no hay `stock`, hay un
// LEDGER; y por eso este dominio no toca `productos_inventario` (lo que el
// comercio tiene) ni `producto_compras` (lo que un cliente le compra a una
// empresa). Son las tres capas del §1.3 del documento de arquitectura y
// mezclarlas es el error que este archivo existe para impedir.
//
// POR QUÉ NO SE REUTILIZAN `proveedores` NI `ordenes_compra`: esas son las
// compras DEL COMERCIO a sus proveedores de insumos, con el `companyId` del
// comprador. Aquí el comprador es la plataforma. Reutilizarlas obligaría a
// inventar una "empresa Membego" dentro de su propio multi-tenant y a mezclar
// el gasto operativo de un lavadero con la inversión promocional de Membego.
// ──────────────────────────────────────────────────────────────────────────

// ── Vocabulario del dominio ─────────────────────────────────────────────────

/// Cómo cumple el proveedor la unidad comprada. NO cambia el modelo de datos:
/// cambia qué se valida al emitir y al redimir. Una arquitectura, seis
/// industrias (restaurante, car wash, barbería, café, turismo, producto físico).
enum SupplyTipo {
  /// Se prepara cuando llega el cliente. Ej.: una pizza.
  ON_DEMAND
  /// Unidades físicas apartadas en el comercio. Ej.: 500 termos.
  STOCK_RESERVADO
  /// Capacidad de servicio comprometida. Ej.: 500 lavados.
  CAPACIDAD_SERVICIO
  /// Capacidad con fecha y cupo. Ej.: 100 excursiones. Exige reserva.
  CAPACIDAD_AGENDADA
}

/// LA DISTINCIÓN QUE NO SE PUEDE PERDER (§5 de la arquitectura).
///
/// COMPRA_UNIDAD_COMPLETA: Membego pagó la unidad entera. El cliente NO vuelve
/// a pagarle la unidad base al comercio — solo los extras. Si Membego la
/// revende, el dinero lo cobra Membego.
///
/// SUBSIDIO: Membego financia una parte. El cliente le paga el resto AL
/// COMERCIO. No es una compra: es una promoción cofinanciada.
enum SupplyModeloComercial {
  COMPRA_UNIDAD_COMPLETA
  SUBSIDIO
  /// VENTA SIN PRECOMPRA (§14 del encargo). Membego NO compra nada: vende el
  /// producto del proveedor, cobra al cliente, y cuando el proveedor entrega
  /// nace una CUENTA POR PAGAR por el neto (bruto − comisión). No hay lote, no
  /// hay derecho, no hay ledger de cubetas: es otro modelo económico y vive en
  /// `supply_ventas_directas`, no en `supply_lotes`.
  COMISION
}

/// Cuándo cobra el proveedor. Protege el flujo de caja de Membego: prometer
/// 1.000 unidades no obliga a desembolsar 1.000 unidades por adelantado.
/// Cómo se estructura comercialmente el acuerdo (§3 del encargo 2026-09 bis).
/// Es la etiqueta con la que se elige en el wizard; el modelo comercial y la
/// modalidad de pago se derivan de ella y siguen mandando en el dominio.
enum SupplyTipoAcuerdo {
  /// Compra anticipada de unidades concretas.
  COMPRA_PREPAGO
  /// Depósito abierto a cuenta de compras futuras.
  DEPOSITO_ABIERTO
  /// Membego compra y paga después (plazo).
  PAGO_POSTERIOR
  /// Membego vende lo del proveedor y retiene comisión.
  VENTA_COMISION
  /// Subsidio u otras combinaciones.
  HIBRIDO
}

/// Sobre qué aplica el acuerdo: un ítem concreto, una categoría del catálogo
/// del proveedor o todo su catálogo («15% sobre todo el menú»).
enum SupplyAlcanceAcuerdo {
  ITEM
  CATEGORIA
  CATALOGO
}

enum SupplyModalidadPago {
  PREPAGO_TOTAL
  PREPAGO_PARCIAL
  PAGO_POR_REDENCION
  SUBSIDIO
}

/// Qué pasa con lo que no se usó antes de vencer. Se negocia en el contrato;
/// el motor de vencimientos PROPONE según esta política y nunca aplica sola.
enum SupplyPoliticaSobrante {
  EXPIRAR
  EXTENDER
  REEMBOLSO
  CREDITO_COMERCIO
  CONVERTIR
  RENEGOCIAR
}

enum SupplyAcuerdoEstado {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  ACTIVO
  /// Pausado por decisión de Membego (incidencias, deuda, renegociación). No
  /// emite ni vende; las obligaciones ya nacidas siguen vivas. Vuelve a ACTIVO.
  SUSPENDIDO
  COMPLETADO
  VENCIDO
  CANCELADO
}

/// Cada cuánto se corta y se liquida un acuerdo.
enum SupplyFrecuenciaCorte {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum SupplyOrdenEstado {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  CONFIRMADA
  PARCIALMENTE_FONDEADA
  FONDEADA
  ACTIVA
  COMPLETADA
  CANCELADA
}

enum SupplyLoteEstado {
  PROGRAMADO
  ACTIVO
  AGOTADO
  VENCIDO
  CANCELADO
  CERRADO
}

/// LAS SEIS CUBETAS DE UN LOTE. El invariante del §3.2:
///   comprado = DISPONIBLE + ASIGNADO + RETENIDO + EMITIDO + REDIMIDO + CERRADO
///
/// ASIGNADO no es consumido y EMITIDO no es entregado: son las dos confusiones
/// que destruyen la contabilidad de una campaña. Un voucher emitido que nadie
/// canjea no le costó nada a Membego todavía.
enum SupplyCubeta {
  DISPONIBLE
  ASIGNADO
  RETENIDO
  EMITIDO
  REDIMIDO
  CERRADO
}

/// Tipos de asiento del ledger. Cada uno declara un traslado entre cubetas
/// (ver `MOVIMIENTO_TRASLADO` en src/modules/supply/ledger.ts, que es la
/// fuente de verdad ejecutable de esta tabla).
enum SupplyMovimientoTipo {
  COMPRA
  ASIGNACION
  LIBERACION_ASIGNACION
  RETENCION
  LIBERACION_RETENCION
  EMISION
  DEVOLUCION_EMISION
  REDENCION
  REVERSA_REDENCION
  EXPIRACION
  CANCELACION
  AJUSTE
  TRANSFERENCIA
}

/// De dónde salió el derecho que posee un cliente. Es la dimensión con la que
/// se compara el costo de adquisición entre canales.
enum SupplyOrigenDerecho {
  CAMPANA_BIENVENIDA
  REGALO
  OFERTA
  COMPRA
  MEMBRESIA
  RECOMPENSA
  REFERIDO
  INFLUENCER
  SOPORTE
  MANUAL
}

enum SupplyDerechoEstado {
  /// Hold temporal de checkout/reserva. Tiene `retencionExpiraAt`.
  RETENIDO
  ACTIVO
  REDIMIDO
  VENCIDO
  CANCELADO
  REVOCADO
}

enum SupplyVoucherEstado {
  ACTIVO
  REDIMIDO
  VENCIDO
  CANCELADO
  REVOCADO
}

enum SupplyIncidenciaTipo {
  BENEFICIO_NEGADO
  PRODUCTO_NO_DISPONIBLE
  PRODUCTO_INCORRECTO
  COBRO_INDEBIDO
  EMPRESA_CERRADA
  CALIDAD_INSUFICIENTE
  SUCURSAL_NO_ACEPTO
  /// El escáner no reconoció el código (§19).
  QR_INVALIDO
  /// Se entregó una cantidad distinta de la comprada.
  CANTIDAD_INCORRECTA
  /// El cliente llegó con un derecho ya vencido.
  DERECHO_VENCIDO
  /// Se intentó, o se registró, la misma unidad dos veces.
  DOBLE_REDENCION
  /// Sospecha de fraude: código compartido, suplantación, entrega ficticia.
  SOSPECHA_FRAUDE
  /// Error de quien operó: escaneó al cliente equivocado, marcó entregado sin entregar.
  ERROR_HUMANO
  /// Reclamo general del cliente que no encaja en los anteriores.
  RECLAMO_CLIENTE
  OTRO
}

enum SupplyIncidenciaEstado {
  ABIERTA
  EN_REVISION
  /// Membego pidió información o una acción al proveedor y espera.
  ESPERANDO_PROVEEDOR
  /// Membego pidió información al cliente y espera.
  ESPERANDO_CLIENTE
  RESUELTA_CLIENTE
  RESUELTA_COMERCIO
  RESUELTA_MEMBEGO
  /// Se revisó y no procede: la operación original se sostiene.
  RECHAZADA
  CERRADA
}

/// Asientos del ledger FINANCIERO del proveedor (§6). El saldo nunca se guarda:
/// se suma. `COMPROMISO_COMPRA` es memorando (no mueve caja) y por eso no entra
/// en el saldo por pagar; está para poder contrastar contratado contra pagado.
enum SupplyAsientoTipo {
  COMPROMISO_COMPRA
  DEPOSITO
  REDENCION_POR_PAGAR
  PAGO
  REEMBOLSO
  CREDITO
  AJUSTE
  REVERSA
  /// Nació una cuenta por pagar (factura del proveedor, venta directa
  /// entregada, ajuste): a favor del proveedor, positivo.
  CUENTA_POR_PAGAR
  /// Nació una cuenta por cobrar (reembolso pendiente, penalización,
  /// diferencia conciliada): a favor de Membego, negativo.
  CUENTA_POR_COBRAR
}

enum SupplyPagoTipo {
  ANTICIPO
  DEPOSITO
  LIQUIDACION_REDENCIONES
  LIQUIDACION_FINAL
  REEMBOLSO
  AJUSTE
  CREDITO
}

// ── Contrato ────────────────────────────────────────────────────────────────

/// EL CONTRATO. La orden de compra dice QUÉ se compró; el acuerdo dice CÓMO
/// funciona: vigencia, sucursales, capacidad, sustituciones, qué pasa con lo
/// que sobre y qué pasa si el comercio cierra.
///
/// `proveedorId` es una `Company` normal con la capacidad MEMBEGO_SUPPLIER
/// encendida. No se crea una segunda empresa: la misma organización es comercio
/// y proveedora a la vez (Fase 1 del prompt).
model SupplyAcuerdo {
  id          String  @id @default(cuid())
  /// Código legible para hablar con el proveedor: "MBG-LITRE-2026-001".
  codigo      String  @unique
  proveedorId String
  proveedor   Company @relation("SupplyProveedorAcuerdos", fields: [proveedorId], references: [id], onDelete: Restrict)

  estado SupplyAcuerdoEstado @default(BORRADOR)

  tipo             SupplyTipo
  modeloComercial  SupplyModeloComercial  @default(COMPRA_UNIDAD_COMPLETA)
  tipoAcuerdo      SupplyTipoAcuerdo      @default(COMPRA_PREPAGO)
  alcance          SupplyAlcanceAcuerdo   @default(ITEM)
  /// Categoría del catálogo cuando `alcance` = CATEGORIA.
  categoriaCodigo  String?
  modalidadPago    SupplyModalidadPago    @default(PREPAGO_PARCIAL)
  politicaSobrante SupplyPoliticaSobrante @default(EXPIRAR)

  // ── Qué se compra ────────────────────────────────────────────────────────
  // NO se crea un catálogo paralelo: el acuerdo APUNTA al ítem del catálogo
  // existente cuando lo hay (un Servicio o una Promoción de esa empresa) y
  // siempre guarda el nombre con el que se contrató. `varianteEtiqueta` es la
  // variante ("Grande pepperoni") sin obligar a modelar variantes en verticales
  // que no las tienen.
  servicioId       String?
  servicio         Servicio?  @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  promocionId      String?
  promocion        Promocion? @relation(fields: [promocionId], references: [id], onDelete: SetNull)
  itemNombre       String
  itemDescripcion  String?
  varianteEtiqueta String?

  // ── Economía contratada ──────────────────────────────────────────────────
  /// En COMISION no se compra nada: `cantidad` es el TOPE de unidades que
  /// Membego se compromete a vender bajo este acuerdo y `costoUnitario` es 0.
  cantidad           Int
  costoUnitario      Decimal  @db.Decimal(12, 2)
  /// Precio público de referencia al firmar. Sirve para medir el descuento
  /// conseguido; NO es lo que se le cobra a nadie.
  precioReferencia   Decimal? @db.Decimal(12, 2)
  /// En SUBSIDIO: cuánto aporta Membego por unidad. En compra completa es null
  /// porque el aporte ES el costo unitario.
  aporteMembego      Decimal? @db.Decimal(12, 2)
  moneda             String   @default("DOP")
  /// Porcentaje de anticipo en PREPAGO_PARCIAL (0-100).
  anticipoPorcentaje Decimal? @db.Decimal(5, 2)
  condicionesPago    String?

  // ── Condiciones comerciales y de liquidación (§4 del encargo) ───────────
  /// En COMISION: lo que Membego retiene de cada venta (0-100). Se congela en
  /// cada venta al abrirla: cambiarlo después no altera ventas históricas.
  comisionPorcentaje   Decimal?               @db.Decimal(5, 2)
  /// Descuento negociado sobre el precio público, informativo.
  descuentoPorcentaje  Decimal?               @db.Decimal(5, 2)
  /// Impuesto aplicable a las facturas del proveedor (ITBIS), informativo.
  impuestoPorcentaje   Decimal?               @db.Decimal(5, 2)
  /// Días de plazo desde el corte para pagar la liquidación.
  plazoPagoDias        Int?
  frecuenciaCorte      SupplyFrecuenciaCorte?
  /// Cómo se paga la liquidación: "Transferencia", "Cheque", "Compensación con depósito"…
  metodoLiquidacion    String?
  politicaDevoluciones String?
  slaTexto             String?
  /// Versión vigente de las condiciones. Cada enmienda o cambio aprobado la
  /// incrementa y guarda un snapshot en `supply_acuerdo_versiones`: una
  /// liquidación histórica apunta a la versión con la que se calculó.
  version              Int                    @default(1)
  suspendidoMotivo     String?

  // ── Vigencia y alcance ───────────────────────────────────────────────────
  inicioAt DateTime
  finAt    DateTime

  /// Sucursales donde se puede canjear. Vacío = todas las de la empresa.
  /// Ids de `sucursales`; sin tabla puente porque es una lista corta de solo
  /// lectura que se copia al lote y ahí queda congelada.
  sucursalIds String[] @default([])

  // ── Capacidad operativa (Fase 18) ────────────────────────────────────────
  // No se compran 1.000 pizzas para que aparezcan 700 personas el sábado.
  capacidadDiaria  Int?
  capacidadHoraria Int?
  /// Fechas bloqueadas (ISO yyyy-mm-dd).
  diasBloqueados   String[] @default([])
  /// Ventana de atención, texto libre acordado ("11:00-22:00").
  horarioTexto     String?

  reglasRedencion     String?
  reglasSustitucion   String?
  reglasCumplimiento  String?
  politicaCancelacion String?
  notas               String?

  creadoPorId   String?
  creadoPor     User?     @relation("SupplyAcuerdoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  aprobadoPorId String?
  aprobadoPor   User?     @relation("SupplyAcuerdoAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enmiendas SupplyEnmienda[]
  ordenes   SupplyOrden[]
  lotes     SupplyLote[]
  pagos     SupplyPago[]
  asientos  SupplyAsientoFinanciero[]

  versiones        SupplyAcuerdoVersion[]
  depositos        SupplyDeposito[]
  facturas         SupplyFacturaProveedor[]
  ventas           SupplyVentaDirecta[]
  cuentasPorPagar  SupplyCuentaPorPagar[]
  cuentasPorCobrar SupplyCuentaPorCobrar[]
  liquidaciones    SupplyLiquidacion[]
  conciliaciones   SupplyConciliacion[]

  /// Apuntada por una clave COMPUESTA: el hijo no puede colgar de un padre de
  /// otro proveedor. Nace de un agujero medido el 25-09-2026 — la política de
  /// RLS ata la fila por su `proveedorId`, así que nadie miraba de quién era el
  /// padre, y una empresa podía colgar un derecho del lote de otra.
  @@unique([id, proveedorId])
  @@index([proveedorId, estado])
  @@index([estado, finAt])
  @@index([servicioId])
  @@index([promocionId])
  @@map("supply_acuerdos")
}

/// CAMBIO CONTRACTUAL AUDITADO (Fase 20). El comercio ve sus números pero no
/// los edita: pasar de 1.000 a 800 unidades, o de RD$300 a RD$400, solo ocurre
/// por aquí, con antes, después, motivo y quién aprobó.
model SupplyEnmienda {
  id        String        @id @default(cuid())
  acuerdoId String
  acuerdo   SupplyAcuerdo @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)

  /// Qué se cambió: 'VIGENCIA' | 'CANTIDAD' | 'CAPACIDAD' | 'SUCURSALES' |
  /// 'SUSTITUCION' | 'COSTO' | 'POLITICA'.
  campo   String
  antes   Json   @default("{}")
  despues Json   @default("{}")
  motivo  String

  /// Si la enmienda amplió o redujo unidades, el asiento de AJUSTE que lo
  /// reflejó en el ledger del lote. Sin esto, cambiar la cantidad del contrato
  /// dejaría el lote y el acuerdo diciendo cosas distintas.
  movimientoId String? @unique

  solicitadoPorId String?
  solicitadoPor   User?     @relation("SupplyEnmiendaSolicitadaPor", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  aprobadoPorId   String?
  aprobadoPor     User?     @relation("SupplyEnmiendaAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([acuerdoId, createdAt])
  @@map("supply_enmiendas")
}

// ── Procurement ─────────────────────────────────────────────────────────────

/// LA ORDEN DE COMPRA DE MEMBEGO AL PROVEEDOR.
///
/// `creadoPor` ≠ `aprobadoPor` no es burocracia: una orden es un compromiso
/// financiero de cientos de miles de pesos y no puede nacer de un solo clic de
/// cualquiera con sesión.
model SupplyOrden {
  id          String        @id @default(cuid())
  /// Correlativo legible: "MBG-PO-000127".
  numero      String        @unique
  acuerdoId   String
  acuerdo     SupplyAcuerdo @relation(fields: [acuerdoId, proveedorId], references: [id, proveedorId], onDelete: Restrict)
  /// Denormalizado desde el acuerdo: el portal del proveedor filtra por aquí y
  /// no puede depender de un join para su aislamiento.
  proveedorId String
  proveedor   Company       @relation("SupplyProveedorOrdenes", fields: [proveedorId], references: [id], onDelete: Restrict)

  estado SupplyOrdenEstado @default(BORRADOR)

  moneda    String  @default("DOP")
  subtotal  Decimal @db.Decimal(14, 2)
  impuestos Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)

  condicionesPago String?
  notas           String?

  /// Suma de los pagos CONFIRMADOS con `ordenId`. Caché del ledger financiero:
  /// es lo que decide PARCIALMENTE_FONDEADA / FONDEADA sin que nadie lo marque
  /// a mano (hallazgo H4 de la auditoría del 29-09-2026).
  montoPagado Decimal  @default(0) @db.Decimal(14, 2)
  /// Rutas o referencias de documentos adjuntos (cotización, contrato firmado).
  documentos  String[] @default([])

  creadoPorId     String?
  creadoPor       User?     @relation("SupplyOrdenCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  aprobadoPorId   String?
  aprobadoPor     User?     @relation("SupplyOrdenAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoAt      DateTime?
  confirmadaAt    DateTime?
  canceladaAt     DateTime?
  canceladaMotivo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas               SupplyOrdenLinea[]
  lotes                SupplyLote[]
  pagos                SupplyPago[]
  asientos             SupplyAsientoFinanciero[]
  facturas             SupplyFacturaProveedor[]
  aplicacionesDeposito SupplyDepositoMovimiento[]

  @@index([proveedorId, estado])
  @@index([acuerdoId])
  @@index([estado, createdAt])
  @@map("supply_ordenes")
}

model SupplyOrdenLinea {
  id      String      @id @default(cuid())
  ordenId String
  orden   SupplyOrden @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  /// Copia del nombre al comprar: sobrevive a que el proveedor renombre el
  /// producto tres meses después.
  itemNombre       String
  varianteEtiqueta String?
  cantidad         Int
  costoUnitario    Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  lotes SupplyLote[]

  @@index([ordenId])
  @@map("supply_orden_lineas")
}

// ── El lote ─────────────────────────────────────────────────────────────────

/// EL LOTE DE DERECHOS ADQUIRIDOS. La pieza central.
///
/// NO ES `stock = 1000`. Es un conjunto de derechos con condiciones económicas
/// CONGELADAS: si mañana la pizza sube a RD$800 o cambia de nombre, este lote
/// sigue valiendo lo que valía. Por eso todos los campos `snapshot*` se copian
/// al crear y no se vuelven a tocar nunca.
///
/// Los contadores (`disponibles`, `asignadas`…) son CACHÉ del ledger, no la
/// verdad. La verdad es `supply_movimientos`; la conciliación compara ambos y
/// el recálculo siempre va del ledger al contador, nunca al revés.
model SupplyLote {
  id     String @id @default(cuid())
  /// Código del lote: "MBG-LITRE-2026-001".
  codigo String @unique

  acuerdoId   String
  acuerdo     SupplyAcuerdo     @relation(fields: [acuerdoId, proveedorId], references: [id, proveedorId], onDelete: Restrict)
  ordenId     String?
  orden       SupplyOrden?      @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  lineaId     String?
  linea       SupplyOrdenLinea? @relation(fields: [lineaId], references: [id], onDelete: SetNull)
  proveedorId String
  proveedor   Company           @relation("SupplyProveedorLotes", fields: [proveedorId], references: [id], onDelete: Restrict)

  estado SupplyLoteEstado @default(PROGRAMADO)

  // ── Snapshot económico congelado ─────────────────────────────────────────
  snapshotItemNombre       String
  snapshotVariante         String?
  snapshotCostoUnitario    Decimal               @db.Decimal(12, 2)
  snapshotPrecioReferencia Decimal?              @db.Decimal(12, 2)
  snapshotAporteMembego    Decimal?              @db.Decimal(12, 2)
  snapshotModelo           SupplyModeloComercial
  snapshotTipo             SupplyTipo
  snapshotMoneda           String                @default("DOP")
  /// Sucursales habilitadas al crear el lote. Copiadas, no consultadas: añadir
  /// una sucursal a un contrato firmado es una ENMIENDA, no un efecto lateral
  /// de que la empresa abra un local nuevo.
  snapshotSucursalIds      String[]              @default([])
  snapshotCapacidadDiaria  Int?
  snapshotCapacidadHoraria Int?

  inicioAt DateTime
  venceAt  DateTime

  // ── Cubetas (caché del ledger) ───────────────────────────────────────────
  compradas   Int @default(0)
  disponibles Int @default(0)
  asignadas   Int @default(0)
  retenidas   Int @default(0)
  emitidas    Int @default(0)
  redimidas   Int @default(0)
  cerradas    Int @default(0)

  /// Versión optimista: cada mutación de cubetas la incrementa. Es la segunda
  /// red bajo el `FOR UPDATE`, y lo que deja ver en la conciliación si dos
  /// caminos escribieron el mismo lote.
  version Int @default(0)

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimientos  SupplyMovimiento[]
  asignaciones SupplyAsignacion[]
  derechos     SupplyDerecho[]

  /// Apuntada por la clave compuesta de `SupplyDerecho`: un derecho no puede
  /// colgar de un lote de OTRO proveedor.
  @@unique([id, proveedorId])
  @@index([proveedorId, estado])
  @@index([estado, venceAt])
  @@index([acuerdoId])
  @@index([ordenId])
  @@map("supply_lotes")
}

/// EL LEDGER. Un asiento = un traslado de `cantidad` unidades de la cubeta
/// `origen` a la cubeta `destino`. `origen` nulo = entran al lote (compra o
/// ajuste que amplía); `destino` nulo = salen del lote (transferencia).
///
/// NUNCA SE BORRA UN ASIENTO. Un error se corrige con REVERSA_REDENCION,
/// AJUSTE o CANCELACION, con motivo, actor, fecha y referencia. Esta tabla es
/// la única fuente de verdad de cuánto supply queda.
model SupplyMovimiento {
  id     String     @id @default(cuid())
  loteId String
  lote   SupplyLote @relation(fields: [loteId], references: [id], onDelete: Restrict)

  tipo     SupplyMovimientoTipo
  origen   SupplyCubeta?
  destino  SupplyCubeta?
  /// SIEMPRE positiva. El signo lo da el par (origen, destino), no el número:
  /// una cantidad negativa haría que dos asientos distintos pudieran significar
  /// lo mismo y que el invariante dependiera de quién lo escribió.
  cantidad Int

  // ── A qué se debe este asiento ───────────────────────────────────────────
  asignacionId String?
  derechoId    String?
  redencionId  String?
  /// Referencia externa libre: nº de enmienda, id de campaña, lote destino de
  /// una transferencia. Los dos asientos de una transferencia la comparten.
  referencia   String?
  motivo       String?

  /// Las seis cubetas ANTES y DESPUÉS de este asiento (§8 del encargo:
  /// «previous balance / new balance»). Redundante con la suma del ledger a
  /// propósito: permite leer un asiento suelto y saber qué dejó, y detectar en
  /// conciliación un asiento que se coló fuera de orden.
  saldoAntes   Json @default("{}")
  saldoDespues Json @default("{}")

  actorId       String?
  actor         User?   @relation("SupplyMovimientoActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Correlación con la petición que lo provocó (auditoría, Fase 43).
  correlationId String?

  createdAt DateTime @default(now())

  @@index([loteId, createdAt])
  @@index([loteId, tipo])
  @@index([asignacionId])
  @@index([derechoId])
  @@index([redencionId])
  @@index([referencia])
  @@map("supply_movimientos")
}

// ── Asignación ──────────────────────────────────────────────────────────────

/// RESERVA DE UNIDADES PARA UN DESTINO (Fase 8). Membego no tiene que decidir
/// el destino de las 1.000 unidades al comprarlas: asigna cuando quiere y
/// libera lo que no usa.
///
/// ASIGNAR NO ES CONSUMIR. `cantidad` es lo apartado; `emitidas` lo que ya se
/// entregó a clientes desde esta asignación. `cantidad - emitidas` es lo que
/// queda por emitir en la campaña.
model SupplyAsignacion {
  id     String     @id @default(cuid())
  loteId String
  lote   SupplyLote @relation(fields: [loteId], references: [id], onDelete: Restrict)

  /// Para qué se aparta: 'CAMPANA' | 'OFERTA' | 'MEMBRESIA' | 'RECOMPENSA' |
  /// 'REFERIDO' | 'INFLUENCER' | 'REGALO' | 'RESERVA'.
  destinoTipo String
  /// Id de la entidad del destino cuando existe (campaña, plan, programa…).
  /// Sin FK: los destinos viven en cinco tablas distintas y una FK obligaría a
  /// cinco columnas nulables que nadie mantendría al añadir la sexta.
  destinoId   String?
  /// Nombre con el que se lee en los reportes ("Bienvenida Membego").
  etiqueta    String

  cantidad  Int
  emitidas  Int @default(0)
  /// Unidades devueltas al lote por liberación explícita o por cierre.
  liberadas Int @default(0)

  /// Lo que el cliente le paga a MEMBEGO por una unidad de esta asignación.
  /// 0 = se regala. Vive aquí y no en el lote porque el mismo lote se reparte a
  /// la vez entre una campaña de bienvenida (gratis) y una oferta (RD$399): el
  /// precio es de la asignación, no de lo comprado.
  precioCliente Decimal @default(0) @db.Decimal(12, 2)

  /// Ventana de publicación de la oferta. Nulos = la vigencia del lote.
  inicioAt      DateTime?
  finAt         DateTime?
  /// Máximo de unidades que una misma persona puede obtener. Nulo = una.
  maxPorCliente Int?
  /// Sucursales donde vale esta oferta. Vacío = las del lote.
  sucursalIds   String[]  @default([])

  activa    Boolean   @default(true)
  cerradaAt DateTime?

  creadoPorId String?
  creadoPor   User?   @relation("SupplyAsignacionCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  derechos SupplyDerecho[]

  @@index([loteId, activa])
  @@index([destinoTipo, destinoId])
  @@map("supply_asignaciones")
}

// ── Derecho del cliente ─────────────────────────────────────────────────────

/// LO QUE UNA PERSONA POSEE HOY (Fase 11). "Carlos tiene derecho a una pizza
/// grande de pepperoni del lote MBG-LITRE-001, vence el 30 de noviembre."
///
/// RETENIDO es el hold del §10: el checkout aparta la unidad antes de cobrar y
/// la suelta si no paga. Sin él, dos personas compran la última unidad.
model SupplyDerecho {
  id           String            @id @default(cuid())
  loteId       String
  lote         SupplyLote        @relation(fields: [loteId, proveedorId], references: [id, proveedorId], onDelete: Restrict)
  asignacionId String?
  asignacion   SupplyAsignacion? @relation(fields: [asignacionId], references: [id], onDelete: SetNull)

  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Empresa que cumple. Denormalizada para que el portal del proveedor filtre
  /// sin joins y su aislamiento no dependa de tres saltos.
  proveedorId String
  proveedor   Company @relation("SupplyProveedorDerechos", fields: [proveedorId], references: [id], onDelete: Restrict)

  estado SupplyDerechoEstado @default(ACTIVO)
  origen SupplyOrigenDerecho

  /// Costo de ESTA unidad congelado al emitir: el snapshot del lote puede
  /// cambiar por enmienda y el costo de adquisición de Carlos no.
  costoUnitario Decimal @db.Decimal(12, 2)
  moneda        String  @default("DOP")
  /// Lo que el cliente pagó A MEMBEGO por este derecho (0 = regalo).
  precioCliente Decimal @default(0) @db.Decimal(12, 2)

  vencAt        DateTime
  emitidoAt     DateTime  @default(now())
  redimidoAt    DateTime?
  cerradoAt     DateTime?
  cerradoMotivo String?

  /// Hold: hasta cuándo vale la retención. Solo con estado RETENIDO.
  retencionExpiraAt DateTime?
  /// De qué cubeta salió al retenerse/emitirse, para devolverla a la correcta.
  cubetaOrigen      SupplyCubeta @default(DISPONIBLE)

  /// IDEMPOTENCIA (Fase 44): un reintento de "reclamar mi pizza" devuelve el
  /// mismo derecho en vez de emitir dos. Único a nivel de base.
  claveIdempotencia String? @unique

  meta Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers      SupplyVoucher[]
  reservas      SupplyReserva[]
  ventaComoBono SupplyVentaDirecta? @relation("SupplyVentaBono")

  /// El pedido que lo paga, si esta unidad se vendió en vez de regalarse.
  pedido SupplyPedido?

  /// Apuntada por una clave COMPUESTA: el hijo no puede colgar de un padre de
  /// otro proveedor. Nace de un agujero medido el 25-09-2026 — la política de
  /// RLS ata la fila por su `proveedorId`, así que nadie miraba de quién era el
  /// padre, y una empresa podía colgar un derecho del lote de otra.
  @@unique([id, proveedorId])
  @@index([clienteId, estado])
  @@index([loteId, estado])
  @@index([proveedorId, estado])
  @@index([asignacionId])
  @@index([estado, vencAt])
  @@index([estado, retencionExpiraAt])
  @@map("supply_derechos")
}

/// CÓMO SE PRESENTA EL DERECHO EN EL MOSTRADOR (Fase 12).
///
/// NO ES UN CUPÓN. Un cupón modifica un precio; un voucher representa el
/// derecho a RECIBIR algo. Se separa del derecho porque un derecho puede
/// reemitir su voucher (se perdió, se revocó) sin dejar de ser el mismo
/// derecho, y porque el historial de códigos emitidos tiene que sobrevivir.
model SupplyVoucher {
  id        String        @id @default(cuid())
  derechoId String
  derecho   SupplyDerecho @relation(fields: [derechoId, proveedorId], references: [id, proveedorId], onDelete: Cascade)

  /// Código al portador. 24 bytes de `randomBytes` en base64url, igual que los
  /// QR de membresía: no es un identificador, es una credencial.
  codigo String @unique

  estado SupplyVoucherEstado @default(ACTIVO)

  proveedorId String
  proveedor   Company  @relation("SupplyProveedorVouchers", fields: [proveedorId], references: [id], onDelete: Restrict)
  /// Sucursales donde vale, copiadas del lote. Vacío = todas las del proveedor.
  sucursalIds String[] @default([])

  vigenteDesde DateTime @default(now())
  vigenteHasta DateTime

  emitidoAt     DateTime  @default(now())
  redimidoAt    DateTime?
  cerradoAt     DateTime?
  cerradoMotivo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sesionesQr  SupplyQrSesion[]
  redenciones SupplyRedencion[]

  /// Apuntada por una clave COMPUESTA: el hijo no puede colgar de un padre de
  /// otro proveedor. Nace de un agujero medido el 25-09-2026 — la política de
  /// RLS ata la fila por su `proveedorId`, así que nadie miraba de quién era el
  /// padre, y una empresa podía colgar un derecho del lote de otra.
  @@unique([id, proveedorId])
  @@index([derechoId])
  @@index([proveedorId, estado])
  @@index([estado, vigenteHasta])
  @@map("supply_vouchers")
}

/// QR DINÁMICO (Fase 13). El cliente pulsa "Usar beneficio" y se abre una
/// sesión de cinco minutos. El QR lleva un `nonce` que no dice nada por sí
/// mismo: no hay datos manipulables dentro, solo una llave que apunta aquí.
///
/// ANTIREPLAY: `consumidoAt` no nulo invalida el segundo escaneo del mismo
/// código aunque el voucher siguiera activo, y `nonce` es único en toda la
/// tabla. Reenviar la misma foto del QR no entrega dos pizzas.
model SupplyQrSesion {
  id        String        @id @default(cuid())
  voucherId String
  voucher   SupplyVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  nonce    String   @unique
  expiraAt DateTime

  /// Sucursal que el cliente eligió al abrir la sesión, si la hubo. El escáner
  /// de otra sucursal rechaza el código.
  sucursalId           String?
  /// Dispositivo que abrió la sesión (user-agent recortado) y el que la
  /// consumió. Sirven para investigar un código compartido (§12).
  dispositivo          String?
  consumidoDispositivo String?

  consumidoAt    DateTime?
  consumidoPorId String?
  consumidoPor   User?     @relation("SupplyQrConsumidoPor", fields: [consumidoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([voucherId, createdAt])
  @@index([expiraAt])
  @@map("supply_qr_sesiones")
}

/// RESERVA DE RECOGIDA (Fases 17-18). Para ON_DEMAND y CAPACIDAD_AGENDADA:
/// sucursal, día y hora dentro de la capacidad que el proveedor comprometió.
model SupplyReserva {
  id        String        @id @default(cuid())
  derechoId String
  derecho   SupplyDerecho @relation(fields: [derechoId, proveedorId], references: [id, proveedorId], onDelete: Cascade)

  proveedorId String
  proveedor   Company  @relation("SupplyProveedorReservas", fields: [proveedorId], references: [id], onDelete: Restrict)
  sucursalId  String
  sucursal    Sucursal @relation("SupplyReservaSucursal", fields: [sucursalId], references: [id], onDelete: Restrict)

  /// Día en ISO local (yyyy-mm-dd) del proveedor. Se guarda como texto porque
  /// la capacidad diaria se cuenta por día DEL COMERCIO, no por ventana UTC:
  /// con `DateTime` un pedido de las 22:30 caería en el cupo del día siguiente.
  dia      String
  /// Hora local 0-23 para el cupo por hora. Null = el acuerdo no limita por hora.
  hora     Int?
  inicioAt DateTime

  /// 'CONFIRMADA' | 'LISTA' | 'CANCELADA' | 'CUMPLIDA' | 'NO_ASISTIO'.
  ///
  /// LISTA (25-09-2026): el comercio ya lo preparó y espera al cliente. Sigue
  /// OCUPANDO el cupo del día igual que CONFIRMADA —la pizza está hecha, el
  /// horno la produjo— así que toda cuenta de capacidad tiene que incluir las
  /// dos. Solo sale del cupo cuando se entrega (CUMPLIDA) o se cae
  /// (CANCELADA / NO_ASISTIO).
  estado String @default("CONFIRMADA")

  canceladaAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Un derecho tiene como mucho una reserva viva; reprogramar cancela la
  /// anterior. Parcial en SQL sobre estado = 'CONFIRMADA'.
  @@index([proveedorId, dia, hora])
  @@index([derechoId])
  @@index([sucursalId, dia])
  @@map("supply_reservas")
}

// ── Redención ───────────────────────────────────────────────────────────────

/// LA ENTREGA (Fase 15). Con todo el contexto que hace falta para no tener que
/// preguntarle nunca al comercio cuántas unidades entregó este mes.
///
/// Una redención NO SE BORRA. Si el empleado se equivocó, se marca
/// `reversadaAt` y el ledger recibe un REVERSA_REDENCION; la fila original se
/// queda donde está.
model SupplyRedencion {
  id        String        @id @default(cuid())
  voucherId String
  voucher   SupplyVoucher @relation(fields: [voucherId, proveedorId], references: [id, proveedorId], onDelete: Restrict)

  derechoId String
  clienteId String
  cliente   Cliente @relation("SupplyRedencionCliente", fields: [clienteId], references: [id], onDelete: Restrict)

  proveedorId String
  proveedor   Company   @relation("SupplyProveedorRedenciones", fields: [proveedorId], references: [id], onDelete: Restrict)
  sucursalId  String?
  sucursal    Sucursal? @relation("SupplyRedencionSucursal", fields: [sucursalId], references: [id], onDelete: SetNull)

  loteId       String
  acuerdoId    String
  asignacionId String?
  /// Campaña/destino que financió esta unidad, copiado de la asignación para
  /// que el reporte por campaña no dependa de que la asignación siga viva.
  destinoTipo  String?
  destinoId    String?

  /// Empleado que la entregó. La pregunta "¿quién la entregó?" tiene respuesta.
  empleadoId String?
  empleado   User?   @relation("SupplyRedencionEmpleado", fields: [empleadoId], references: [id], onDelete: SetNull)

  /// Costo consumido por Membego en esta entrega. Congelado aquí: es la cifra
  /// que alimenta unit economics y la liquidación al proveedor.
  costoUnitario Decimal @db.Decimal(12, 2)
  moneda        String  @default("DOP")

  /// Extras cobrados por el comercio al cliente EN ESTA ENTREGA (queso, refresco).
  /// Separado a propósito: `coveredByMembego` y `customerPaysMerchant` no se
  /// mezclan contablemente nunca (Fase 59).
  extrasMonto Decimal @default(0) @db.Decimal(12, 2)
  extrasNota  String?

  /// En SUBSIDIO: lo que el cliente le pagó al comercio por la unidad base.
  /// En COMPRA_UNIDAD_COMPLETA esto es 0 y tiene que seguir siendo 0.
  aporteClienteComercio Decimal @default(0) @db.Decimal(12, 2)

  canal String @default("SCANNER")

  reversadaAt     DateTime?
  reversadaPorId  String?
  reversadaPor    User?     @relation("SupplyRedencionReversadaPor", fields: [reversadaPorId], references: [id], onDelete: SetNull)
  reversadaMotivo String?

  /// Idempotencia del escáner: dos toques del botón no entregan dos pizzas.
  claveIdempotencia String? @unique

  createdAt DateTime @default(now())

  incidencias SupplyIncidencia[]

  @@index([proveedorId, createdAt])
  @@index([loteId, createdAt])
  @@index([clienteId, createdAt])
  @@index([sucursalId, createdAt])
  @@index([acuerdoId, createdAt])
  @@index([destinoTipo, destinoId])
  @@map("supply_redenciones")
}

// ── Incidentes y disputas ───────────────────────────────────────────────────

/// INCUMPLIMIENTO (Fases 29-30). "Me negaron el beneficio", "me cobraron la
/// pizza igual", "la sucursal no aceptó el voucher". Se liga a todo lo que
/// haya: voucher, redención, lote, campaña, sucursal.
model SupplyIncidencia {
  id          String  @id @default(cuid())
  proveedorId String
  proveedor   Company @relation("SupplyProveedorIncidencias", fields: [proveedorId], references: [id], onDelete: Restrict)

  clienteId String?
  cliente   Cliente? @relation("SupplyIncidenciaCliente", fields: [clienteId], references: [id], onDelete: SetNull)

  redencionId String?
  redencion   SupplyRedencion?    @relation(fields: [redencionId], references: [id], onDelete: SetNull)
  voucherId   String?
  derechoId   String?
  loteId      String?
  acuerdoId   String?
  sucursalId  String?
  destinoTipo String?
  destinoId   String?
  /// Venta sin precompra afectada, cuando la incidencia es sobre una venta.
  ventaId     String?
  venta       SupplyVentaDirecta? @relation(fields: [ventaId], references: [id], onDelete: SetNull)

  tipo   SupplyIncidenciaTipo
  estado SupplyIncidenciaEstado @default(ABIERTA)

  detalle    String
  resolucion String?

  reportadoPorId String?
  reportadoPor   User?     @relation("SupplyIncidenciaReportadaPor", fields: [reportadoPorId], references: [id], onDelete: SetNull)
  resueltoPorId  String?
  resueltoPor    User?     @relation("SupplyIncidenciaResueltaPor", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  resueltoAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proveedorId, estado])
  @@index([estado, createdAt])
  @@index([loteId])
  @@index([redencionId])
  @@map("supply_incidencias")
}

// ── Dinero con el proveedor ─────────────────────────────────────────────────

/// PAGO DE MEMBEGO AL PROVEEDOR (Fase 33). Anticipo, liquidación de
/// redenciones, saldo final, reembolso, crédito.
model SupplyPago {
  id          String        @id @default(cuid())
  acuerdoId   String
  acuerdo     SupplyAcuerdo @relation(fields: [acuerdoId, proveedorId], references: [id, proveedorId], onDelete: Restrict)
  ordenId     String?
  orden       SupplyOrden?  @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  proveedorId String
  proveedor   Company       @relation("SupplyProveedorPagos", fields: [proveedorId], references: [id], onDelete: Restrict)

  tipo   SupplyPagoTipo
  monto  Decimal        @db.Decimal(14, 2)
  moneda String         @default("DOP")

  /// 'PENDIENTE' | 'CONFIRMADO' | 'ANULADO'.
  estado          String  @default("PENDIENTE")
  metodo          String?
  referencia      String?
  notas           String?
  /// Ruta del comprobante en el bucket privado (no una URL).
  comprobantePath String?

  /// Ventana de redenciones que liquida este pago, cuando es una liquidación.
  periodoDesde DateTime?
  periodoHasta DateTime?

  /// Cuenta por pagar que salda este pago, si paga UNA obligación concreta
  /// (una factura pagada aparte sin tocar el depósito, §3 B del encargo).
  cuentaPorPagarId String?
  cuentaPorPagar   SupplyCuentaPorPagar? @relation(fields: [cuentaPorPagarId], references: [id], onDelete: SetNull)

  registradoPorId String?
  registradoPor   User?     @relation("SupplyPagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  confirmadoAt    DateTime?
  anuladoAt       DateTime?
  anuladoMotivo   String?

  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asientos    SupplyAsientoFinanciero[]
  deposito    SupplyDeposito?
  liquidacion SupplyLiquidacion?

  @@index([proveedorId, estado])
  @@index([acuerdoId, createdAt])
  @@index([ordenId])
  @@map("supply_pagos")
}

/// LEDGER FINANCIERO DEL PROVEEDOR (Fase 34). No existe `supplierBalance`:
/// el saldo es la suma de estos asientos. `monto` positivo = a favor del
/// proveedor (le debemos más), negativo = a favor de Membego.
model SupplyAsientoFinanciero {
  id          String         @id @default(cuid())
  proveedorId String
  proveedor   Company        @relation("SupplyProveedorAsientos", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId   String?
  acuerdo     SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)
  ordenId     String?
  orden       SupplyOrden?   @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  pagoId      String?
  pago        SupplyPago?    @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  tipo   SupplyAsientoTipo
  monto  Decimal           @db.Decimal(14, 2)
  moneda String            @default("DOP")

  /// Redención que lo originó, en PAGO_POR_REDENCION.
  redencionId String?
  referencia  String?
  motivo      String?

  /// Liquidación que absorbió este asiento (una redención por pagar entra en
  /// UNA liquidación y solo una: el reclamo se hace con `UPDATE … WHERE
  /// "liquidacionId" IS NULL`, que es atómico).
  liquidacionId String?
  liquidacion   SupplyLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  actorId String?
  actor   User?   @relation("SupplyAsientoActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([proveedorId, createdAt])
  @@index([acuerdoId, tipo])
  @@index([pagoId])
  @@index([redencionId])
  @@index([liquidacionId])
  @@map("supply_asientos_financieros")
}

// ── Cobro a nombre de la plataforma (Fases 22-23) ───────────────────────────
//
// QUÉ PROBLEMA RESUELVE, Y POR QUÉ NO VALÍA LO QUE YA HABÍA
//
// Cuando Membego compró la unidad entera y la revende, ese dinero lo cobra
// MEMBEGO: el comercio ya cobró por contrato, y volver a cobrarle al cliente
// por la unidad base sería cobrarla dos veces. Pero toda la infraestructura de
// pagos existente cobra a nombre de una EMPRESA: `PaymentContext` lleva
// `companyId`, `MetodoPago` cuelga de `companies` y el proveedor de
// transferencia dice, literalmente, «a las cuentas de la empresa».
//
// De ahí estas dos tablas. Son de PLATAFORMA: no llevan `companyId` y no lo
// llevan a propósito. Un pedido de un cliente a Membego no pertenece a ninguna
// empresa — ni a la del proveedor, que no debe ver a qué precio revende
// Membego, ni a la empresa donde el cliente tiene su ficha, que no tiene nada
// que ver con esta compra.

/// Las cuentas de cobro de MEMBEGO. No son de ninguna empresa.
///
/// Se guardan aquí y no como `MetodoPago` porque `MetodoPago.companyId` es NOT
/// NULL: meter las cuentas de la plataforma ahí obligaría a inventar una
/// empresa «Membego», y esa empresa fantasma se colaría en los listados, los
/// reportes y la derivación de políticas RLS —que deduce el dueño de una fila
/// por su clave foránea a `companies`—.
model SupplyCuentaCobro {
  id            String         @id @default(cuid())
  tipo          MetodoPagoTipo
  /// "Banco Popular · Membego SRL"
  nombre        String
  titular       String?
  numeroCuenta  String?
  tipoCuenta    String?
  /// Texto libre que ve el cliente al pagar.
  instrucciones String?
  moneda        String         @default("DOP")
  activa        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  pedidos SupplyPedido[]

  @@index([activa])
  @@map("supply_cuentas_cobro")
}

enum SupplyPedidoEstado {
  /// Hold puesto, cliente todavía no dijo que pagó.
  INICIADO
  /// El cliente subió comprobante. Espera a que Membego lo mire.
  EN_REVISION
  /// Membego vio el dinero. El derecho ya es utilizable.
  PAGADO
  /// Membego no vio el dinero. El hold se soltó.
  RECHAZADO
  /// Se agotó el hold sin comprobante. La unidad volvió al pool.
  EXPIRADO
  /// Membego devolvió el dinero después de cobrar.
  REEMBOLSADO
  /// El cliente se echó atrás antes de pagar.
  CANCELADO
}

/// Un pedido de un cliente A MEMBEGO. El otro lado de `SupplyOrden`, que es lo
/// que Membego le compra al proveedor.
///
/// LO QUE ESTA TABLA NO HACE
///
/// No mueve el supply. El movimiento vive donde siempre: `retener` puso el
/// derecho en RETENIDO al abrir el pedido, y `confirmarHold` lo pasa a EMITIDO
/// cuando el dinero está. Esta tabla solo responde «¿pagó?», y por eso el
/// campo que de verdad importa es `revisadoPor`: una persona de Membego que
/// mira un comprobante y responde con su nombre encima.
model SupplyPedido {
  id     String             @id @default(cuid())
  /// Código legible: MBG-P-000123.
  numero String             @unique
  estado SupplyPedidoEstado @default(INICIADO)

  clienteId String  @map("clienteId")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  /// El derecho retenido que este pedido paga. Uno por pedido: el índice único
  /// impide que dos pedidos vivos peleen por la misma unidad retenida.
  ///
  /// Opcional desde la venta sin precompra: un pedido paga O un derecho
  /// retenido O una venta directa, nunca los dos ni ninguno
  /// (`CHECK supply_pedidos_un_solo_objeto`).
  derechoId String?             @unique
  derecho   SupplyDerecho?      @relation(fields: [derechoId], references: [id], onDelete: Restrict)
  /// La venta sin precompra que este pedido paga (§14).
  ventaId   String?             @unique
  venta     SupplyVentaDirecta? @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  /// Lo que el cliente debe pagar, congelado al abrir el pedido. Al confirmar
  /// se compara contra esto: un monto que no cuadra no activa nada, igual que
  /// en `confirmarIntento` de las compras de empresa.
  monto  Decimal @db.Decimal(12, 2)
  moneda String  @default("DOP")

  cuentaId String?            @map("cuentaId")
  cuenta   SupplyCuentaCobro? @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  /// RUTA dentro del bucket privado `comprobantes`, no una URL: el bucket es
  /// privado y cada lectura se firma en el momento con `urlComprobante`.
  comprobantePath String?
  comprobanteNota String?
  /// Cómo pagó: TRANSFERENCIA | DEPOSITO | EFECTIVO | MANUAL.
  metodo          String?
  reembolsadoAt   DateTime?
  reembolsoMotivo String?
  comprobanteAt   DateTime?

  /// Quién de Membego lo aprobó o lo rechazó, y cuándo. Nunca el cliente.
  revisadoPor   String?
  revisor       User?     @relation("SupplyPedidoRevisor", fields: [revisadoPor], references: [id], onDelete: Restrict)
  revisadoAt    DateTime?
  motivoRechazo String?

  /// Hasta cuándo aguanta el hold. Se copia del derecho para poder barrer sin
  /// mirar la otra tabla.
  expiraAt DateTime

  /// Una petición repetida no abre dos pedidos ni retiene dos unidades.
  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, expiraAt])
  @@index([clienteId, estado])
  // La cola de revisión (`supply_pedidos_cola_revision_idx`) es un índice
  // PARCIAL —`ON (comprobanteAt) WHERE estado = 'EN_REVISION'`— y vive solo en
  // la migración 20261006: Prisma no expresa índices parciales. Declararlo aquí
  // como `[estado, comprobanteAt]` hacía que `migrate diff` exigiera un índice
  // que ninguna migración crea (y rompía el check «Esquema de base de datos»).
  @@map("supply_pedidos")
}

// ══════════════════════════════════════════════════════════════════════════
// CAPA FINANCIERA (auditoría del 29-09-2026 · §3 B, §5, §14-§18, §21)
//
// Hasta aquí el módulo sabía comprar, repartir y entregar. Lo que faltaba era
// la mitad del dinero: depósitos abiertos, facturas del proveedor, cuentas por
// pagar y por cobrar, liquidaciones con snapshot, conciliación CONTRA el
// proveedor y la venta sin precompra. Cada uno es una entidad con su estado y
// su signo; la pantalla «Finanzas» solo los agrupa.
//
// EL LEDGER FINANCIERO SIGUE SIENDO LA VERDAD DEL SALDO (ADR-0008). Estas
// tablas son sub-libros: dicen QUÉ obligación concreta queda abierta y cuánto
// de ella se saldó, y cada escritura suya deja también su asiento. Si un día
// discrepan, manda el ledger.
// ══════════════════════════════════════════════════════════════════════════

// ── Proveedor ───────────────────────────────────────────────────────────────

enum SupplyProveedorOrigen {
  /// Empresa que ya opera en Membego y además le vende supply.
  REGISTRADA
  /// Proveedor que todavía no usa la plataforma: se le crea una `Company`
  /// mínima e inactiva para colgar de ella el historial. Convertirlo en
  /// empresa registrada es activar esa misma `Company`, no crear otra.
  EXTERNA
}

/// FICHA DEL PROVEEDOR (§5). La identidad sigue siendo `Company`: esto es lo
/// que la relación comercial necesita saber y una empresa normal no tiene
/// (contacto de facturación, banco donde se le paga, plazo, RNC).
model SupplyProveedor {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation("SupplyProveedorPerfil", fields: [companyId], references: [id], onDelete: Restrict)

  origen SupplyProveedorOrigen @default(REGISTRADA)
  activo Boolean               @default(true)

  rnc              String?
  razonSocial      String?
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  banco            String?
  cuentaBancaria   String?
  tipoCuenta       String?
  plazoPagoDias    Int?
  notas            String?
  whatsapp         String?
  direccion        String?
  pais             String?
  moneda           String?  @default("DOP")
  condicionesPago  String?
  documentos       String[] @default([])

  /// Cuándo pasó de EXTERNA a REGISTRADA. El historial no se toca.
  convertidoAt DateTime?

  creadoPorId String?
  creadoPor   User?   @relation("SupplyProveedorCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([origen, activo])
  @@map("supply_proveedores")
}

// ── Versionado del acuerdo (§4) ─────────────────────────────────────────────

/// SNAPSHOT COMPLETO DE LAS CONDICIONES en cada versión. Una liquidación o una
/// venta guardan el número de versión con el que se calcularon: enmendar el
/// acuerdo crea la versión siguiente y NUNCA reescribe la anterior.
model SupplyAcuerdoVersion {
  id        String        @id @default(cuid())
  acuerdoId String
  acuerdo   SupplyAcuerdo @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)

  version      Int
  snapshot     Json
  motivo       String
  enmiendaId   String?   @unique
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?

  creadoPorId String?
  creadoPor   User?    @relation("SupplyAcuerdoVersionCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([acuerdoId, version])
  @@map("supply_acuerdo_versiones")
}

// ── Depósito abierto (§3 B) ─────────────────────────────────────────────────

enum SupplyDepositoEstado {
  /// Registrado; el pago que lo fondea todavía no se confirmó.
  PENDIENTE
  ABIERTO
  PARCIALMENTE_APLICADO
  /// Sin saldo: se aplicó entero.
  AGOTADO
  /// Cerrado por decisión (con o sin saldo devuelto).
  CERRADO
  CANCELADO
}

enum SupplyDepositoMovimientoTipo {
  APERTURA
  /// Se aplicó parte del saldo a una factura o cuenta por pagar.
  APLICACION
  /// Se deshizo una aplicación (factura anulada, disputa).
  REVERSA_APLICACION
  /// El proveedor devolvió saldo no usado.
  DEVOLUCION
  AJUSTE
}

/// DINERO ENTREGADO SIN COMPRA CONCRETA. RD$100.000 al proveedor «a cuenta»:
/// después llegan facturas y Membego decide, factura a factura, si aplica el
/// depósito, paga aparte o lo deja vivo. El saldo disponible es
/// original − aplicado − devuelto, y cada cambio deja un movimiento con saldo
/// antes y después.
model SupplyDeposito {
  id     String @id @default(cuid())
  /// MBG-DEP-000001
  codigo String @unique

  proveedorId String
  proveedor   Company        @relation("SupplyProveedorDepositos", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId   String?
  acuerdo     SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)
  /// El pago que lo fondea. Al confirmarse ese pago el depósito se ABRE.
  pagoId      String?        @unique
  pago        SupplyPago?    @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  estado SupplyDepositoEstado @default(PENDIENTE)

  montoOriginal Decimal @db.Decimal(14, 2)
  /// Cachés de los movimientos. La verdad es `supply_deposito_movimientos`.
  montoAplicado Decimal @default(0) @db.Decimal(14, 2)
  montoDevuelto Decimal @default(0) @db.Decimal(14, 2)
  moneda        String  @default("DOP")

  referencia String?
  notas      String?
  documentos String[] @default([])

  abiertoAt     DateTime?
  /// Fecha prevista de cierre: alimenta los avisos de vencimiento (§20).
  cierraAt      DateTime?
  cerradoAt     DateTime?
  cerradoMotivo String?

  registradoPorId String?
  registradoPor   User?   @relation("SupplyDepositoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  aprobadoPorId   String?
  aprobadoPor     User?   @relation("SupplyDepositoAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  claveIdempotencia String? @unique
  version           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimientos SupplyDepositoMovimiento[]

  @@index([proveedorId, estado])
  @@index([estado, cierraAt])
  @@map("supply_depositos")
}

model SupplyDepositoMovimiento {
  id         String         @id @default(cuid())
  depositoId String
  deposito   SupplyDeposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  tipo         SupplyDepositoMovimientoTipo
  /// Siempre positivo; el sentido lo da el tipo.
  monto        Decimal                      @db.Decimal(14, 2)
  /// Saldo DISPONIBLE antes y después (§3 B: nunca se pierde trazabilidad).
  saldoAntes   Decimal                      @db.Decimal(14, 2)
  saldoDespues Decimal                      @db.Decimal(14, 2)

  facturaId        String?
  factura          SupplyFacturaProveedor? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  cuentaPorPagarId String?
  cuentaPorPagar   SupplyCuentaPorPagar?   @relation(fields: [cuentaPorPagarId], references: [id], onDelete: SetNull)
  liquidacionId    String?
  liquidacion      SupplyLiquidacion?      @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)
  /// Orden de compra pagada con este depósito (fondeo).
  ordenId          String?
  orden            SupplyOrden?            @relation(fields: [ordenId], references: [id], onDelete: SetNull)

  motivo     String?
  referencia String?

  actorId String?
  actor   User?   @relation("SupplyDepositoMovimientoActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([depositoId, createdAt])
  @@index([ordenId])
  @@map("supply_deposito_movimientos")
}

// ── Facturas del proveedor (§21) ────────────────────────────────────────────

enum SupplyFacturaTipo {
  FACTURA
  /// A favor de Membego: genera una cuenta por cobrar.
  NOTA_CREDITO
  /// A favor del proveedor: genera una cuenta por pagar.
  NOTA_DEBITO
}

enum SupplyFacturaEstado {
  REGISTRADA
  PARCIALMENTE_PAGADA
  PAGADA
  DISPUTADA
  ANULADA
}

/// DOCUMENTO QUE EL PROVEEDOR EMITE A MEMBEGO. No se implementa legislación
/// fiscal (§21): se guarda el documento y la relación financiera correcta.
/// Registrarla crea su cuenta por pagar (o por cobrar, si es nota de crédito).
model SupplyFacturaProveedor {
  id     String @id @default(cuid())
  /// Correlativo interno: MBG-FP-000001.
  codigo String @unique
  /// Número del documento tal como lo emitió el proveedor.
  numero String

  proveedorId String
  proveedor   Company        @relation("SupplyProveedorFacturas", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId   String?
  acuerdo     SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)
  ordenId     String?
  orden       SupplyOrden?   @relation(fields: [ordenId], references: [id], onDelete: SetNull)

  tipo   SupplyFacturaTipo   @default(FACTURA)
  estado SupplyFacturaEstado @default(REGISTRADA)

  fechaEmision     DateTime
  fechaVencimiento DateTime?

  subtotal     Decimal @db.Decimal(14, 2)
  impuestos    Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)
  moneda       String  @default("DOP")
  /// Caché de lo saldado por pagos + depósito aplicado. Refleja la CxP.
  montoSaldado Decimal @default(0) @db.Decimal(14, 2)

  documentoPath String?
  notas         String?

  registradoPorId String?
  registradoPor   User?   @relation("SupplyFacturaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuentaPorPagar       SupplyCuentaPorPagar?
  cuentaPorCobrar      SupplyCuentaPorCobrar?
  aplicacionesDeposito SupplyDepositoMovimiento[]

  @@unique([proveedorId, numero])
  @@index([proveedorId, estado])
  @@index([estado, fechaVencimiento])
  @@map("supply_facturas_proveedor")
}

// ── Cuentas por pagar y por cobrar (§15, §16) ───────────────────────────────

enum SupplyCuentaEstado {
  ABIERTA
  PARCIALMENTE_SALDADA
  SALDADA
  DISPUTADA
  CANCELADA
}

enum SupplyCuentaPorPagarOrigen {
  FACTURA_PROVEEDOR
  VENTA_DIRECTA
  AJUSTE
  DIFERENCIA_CONCILIACION
  MANUAL
}

enum SupplyCuentaPorCobrarOrigen {
  REEMBOLSO
  AJUSTE
  PENALIZACION
  DIFERENCIA_CONCILIACION
  SUBSIDIO
  CARGO
  NOTA_CREDITO
  OTRO
}

/// LO QUE MEMBEGO DEBE A UN PROVEEDOR, obligación por obligación. Nace de una
/// factura, de una venta directa entregada, de un ajuste o de una conciliación.
/// Se salda por pago directo, por aplicación de depósito o dentro de una
/// liquidación; cada camino deja su rastro y su asiento.
model SupplyCuentaPorPagar {
  id     String @id @default(cuid())
  /// MBG-CXP-000001
  codigo String @unique

  proveedorId String
  proveedor   Company        @relation("SupplyProveedorCuentasPorPagar", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId   String?
  acuerdo     SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)

  origen      SupplyCuentaPorPagarOrigen
  descripcion String

  facturaId      String?                 @unique
  factura        SupplyFacturaProveedor? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  ventaId        String?                 @unique
  venta          SupplyVentaDirecta?     @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  discrepanciaId String?                 @unique
  discrepancia   SupplyDiscrepancia?     @relation("SupplyDiscrepanciaCxP", fields: [discrepanciaId], references: [id], onDelete: SetNull)

  montoBruto   Decimal @db.Decimal(14, 2)
  comision     Decimal @default(0) @db.Decimal(14, 2)
  descuentos   Decimal @default(0) @db.Decimal(14, 2)
  impuestos    Decimal @default(0) @db.Decimal(14, 2)
  /// Lo que de verdad se debe: bruto − comisión − descuentos + impuestos.
  montoNeto    Decimal @db.Decimal(14, 2)
  montoSaldado Decimal @default(0) @db.Decimal(14, 2)
  moneda       String  @default("DOP")

  estado        SupplyCuentaEstado @default(ABIERTA)
  vencimientoAt DateTime?

  /// Liquidación que la incluyó. Se reclama con `UPDATE … WHERE NULL`.
  liquidacionId String?
  liquidacion   SupplyLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  disputaMotivo String?
  notas         String?
  documentos    String[] @default([])

  creadoPorId String?
  creadoPor   User?   @relation("SupplyCxPCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagos                SupplyPago[]
  aplicacionesDeposito SupplyDepositoMovimiento[]

  @@index([proveedorId, estado])
  @@index([estado, vencimientoAt])
  @@index([liquidacionId])
  @@map("supply_cuentas_por_pagar")
}

/// LO QUE UN PROVEEDOR DEBE A MEMBEGO: reembolso pendiente, penalización,
/// diferencia conciliada, subsidio a recuperar, nota de crédito.
model SupplyCuentaPorCobrar {
  id     String @id @default(cuid())
  /// MBG-CXC-000001
  codigo String @unique

  proveedorId String
  proveedor   Company        @relation("SupplyProveedorCuentasPorCobrar", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId   String?
  acuerdo     SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)

  origen      SupplyCuentaPorCobrarOrigen
  descripcion String

  facturaId      String?                 @unique
  factura        SupplyFacturaProveedor? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  discrepanciaId String?                 @unique
  discrepancia   SupplyDiscrepancia?     @relation("SupplyDiscrepanciaCxC", fields: [discrepanciaId], references: [id], onDelete: SetNull)

  montoNeto    Decimal @db.Decimal(14, 2)
  montoSaldado Decimal @default(0) @db.Decimal(14, 2)
  moneda       String  @default("DOP")

  estado        SupplyCuentaEstado @default(ABIERTA)
  vencimientoAt DateTime?

  liquidacionId String?
  liquidacion   SupplyLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  disputaMotivo String?
  notas         String?
  documentos    String[] @default([])

  creadoPorId String?
  creadoPor   User?   @relation("SupplyCxCCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proveedorId, estado])
  @@index([estado, vencimientoAt])
  @@index([liquidacionId])
  @@map("supply_cuentas_por_cobrar")
}

// ── Liquidaciones (§17) ─────────────────────────────────────────────────────

enum SupplyLiquidacionEstado {
  BORRADOR
  CALCULADA
  EN_REVISION
  APROBADA
  PAGADA
  CONCILIADA
  DISPUTADA
  CANCELADA
}

enum SupplyLiquidacionLineaTipo {
  CUENTA_POR_PAGAR
  CUENTA_POR_COBRAR
  REDENCION
  DEPOSITO_APLICADO
  AJUSTE
}

/// EL CORTE. Agrupa lo devengado en un período —redenciones por pagar, cuentas
/// por pagar y por cobrar— y lo convierte en UN número a transferir. Guarda el
/// SNAPSHOT: cambiar el acuerdo después no altera una liquidación histórica.
model SupplyLiquidacion {
  id     String @id @default(cuid())
  /// MBG-LIQ-000001
  codigo String @unique

  proveedorId    String
  proveedor      Company        @relation("SupplyProveedorLiquidaciones", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId      String?
  acuerdo        SupplyAcuerdo? @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)
  /// Versión del acuerdo con la que se calculó.
  acuerdoVersion Int?

  estado SupplyLiquidacionEstado @default(BORRADOR)

  periodoDesde DateTime
  periodoHasta DateTime
  moneda       String   @default("DOP")

  // ── Snapshot financiero ──────────────────────────────────────────────────
  ventasBrutas     Decimal @default(0) @db.Decimal(14, 2)
  comisionMembego  Decimal @default(0) @db.Decimal(14, 2)
  montoProveedor   Decimal @default(0) @db.Decimal(14, 2)
  redencionesMonto Decimal @default(0) @db.Decimal(14, 2)
  reembolsos       Decimal @default(0) @db.Decimal(14, 2)
  ajustes          Decimal @default(0) @db.Decimal(14, 2)
  impuestos        Decimal @default(0) @db.Decimal(14, 2)
  depositoAplicado Decimal @default(0) @db.Decimal(14, 2)
  /// Lo que hay que transferir. Puede ser negativo: el proveedor debe a Membego.
  netoLiquidar     Decimal @default(0) @db.Decimal(14, 2)
  redenciones      Int     @default(0)
  ventas           Int     @default(0)
  snapshot         Json    @default("{}")

  pagoId String?     @unique
  pago   SupplyPago? @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  calculadaPorId String?
  calculadaPor   User?     @relation("SupplyLiquidacionCalculadaPor", fields: [calculadaPorId], references: [id], onDelete: SetNull)
  calculadaAt    DateTime?
  aprobadaPorId  String?
  aprobadaPor    User?     @relation("SupplyLiquidacionAprobadaPor", fields: [aprobadaPorId], references: [id], onDelete: SetNull)
  aprobadaAt     DateTime?
  pagadaAt       DateTime?
  conciliadaAt   DateTime?
  disputaMotivo  String?
  notas          String?
  documentos     String[]  @default([])

  claveIdempotencia String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas               SupplyLiquidacionLinea[]
  cuentasPorPagar      SupplyCuentaPorPagar[]
  cuentasPorCobrar     SupplyCuentaPorCobrar[]
  asientos             SupplyAsientoFinanciero[]
  aplicacionesDeposito SupplyDepositoMovimiento[]
  conciliaciones       SupplyConciliacion[]

  @@index([proveedorId, estado])
  @@index([estado, periodoHasta])
  @@map("supply_liquidaciones")
}

model SupplyLiquidacionLinea {
  id            String            @id @default(cuid())
  liquidacionId String
  liquidacion   SupplyLiquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  tipo        SupplyLiquidacionLineaTipo
  referencia  String
  descripcion String
  /// Con signo: positivo a favor del proveedor, negativo a favor de Membego.
  monto       Decimal                    @db.Decimal(14, 2)

  cuentaPorPagarId  String?
  cuentaPorCobrarId String?
  redencionId       String?
  depositoId        String?

  createdAt DateTime @default(now())

  @@index([liquidacionId])
  @@index([redencionId])
  @@map("supply_liquidacion_lineas")
}

// ── Conciliación con el proveedor (§18) ─────────────────────────────────────

enum SupplyConciliacionEstado {
  ABIERTA
  EN_REVISION
  CERRADA
}

enum SupplyDiscrepanciaTipo {
  MISSING_REDEMPTION
  DUPLICATE
  VALUE_DIFFERENCE
  PRODUCT_DIFFERENCE
  DATE_DIFFERENCE
  PAYMENT_DIFFERENCE
  /// Hallazgo de la conciliación interna (contadores vs ledger) importado.
  INTERNA
}

enum SupplyDiscrepanciaEstado {
  ABIERTA
  EN_INVESTIGACION
  RESUELTA
  /// Resuelta generando un ajuste (cuenta por pagar o por cobrar).
  AJUSTADA
  APROBADA
  RECHAZADA
}

/// MEMBEGO CONTRA EL PROVEEDOR. Membego registra 125 redenciones; el proveedor
/// dice 123. Aquí se guardan las dos cifras, se crean las discrepancias y se
/// investigan una a una con documentos y comentarios hasta cerrar.
model SupplyConciliacion {
  id     String @id @default(cuid())
  /// MBG-CON-000001
  codigo String @unique

  proveedorId   String
  proveedor     Company            @relation("SupplyProveedorConciliaciones", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId     String?
  acuerdo       SupplyAcuerdo?     @relation(fields: [acuerdoId], references: [id], onDelete: SetNull)
  liquidacionId String?
  liquidacion   SupplyLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  estado SupplyConciliacionEstado @default(ABIERTA)

  periodoDesde DateTime
  periodoHasta DateTime

  // Lo que dice Membego (calculado) y lo que declaró el proveedor.
  membegoRedenciones   Int     @default(0)
  membegoMonto         Decimal @default(0) @db.Decimal(14, 2)
  membegoVentas        Int     @default(0)
  membegoVentasMonto   Decimal @default(0) @db.Decimal(14, 2)
  proveedorRedenciones Int     @default(0)
  proveedorMonto       Decimal @default(0) @db.Decimal(14, 2)
  proveedorVentas      Int     @default(0)
  proveedorVentasMonto Decimal @default(0) @db.Decimal(14, 2)
  proveedorDetalle     Json    @default("{}")

  notas      String?
  documentos String[] @default([])

  creadoPorId  String?
  creadoPor    User?     @relation("SupplyConciliacionCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  cerradoPorId String?
  cerradoPor   User?     @relation("SupplyConciliacionCerradaPor", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradaAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discrepancias SupplyDiscrepancia[]

  @@index([proveedorId, estado])
  @@index([estado, periodoHasta])
  @@map("supply_conciliaciones")
}

model SupplyDiscrepancia {
  id             String             @id @default(cuid())
  conciliacionId String
  conciliacion   SupplyConciliacion @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)

  tipo   SupplyDiscrepanciaTipo
  estado SupplyDiscrepanciaEstado @default(ABIERTA)

  titulo  String
  detalle String

  cantidadMembego   Int?
  cantidadProveedor Int?
  montoMembego      Decimal? @db.Decimal(14, 2)
  montoProveedor    Decimal? @db.Decimal(14, 2)
  /// Positivo = Membego dice más que el proveedor.
  montoDiferencia   Decimal? @db.Decimal(14, 2)

  entidad     String?
  entidadId   String?
  redencionId String?
  ventaId     String?

  resolucion    String?
  resueltoPorId String?
  resueltoPor   User?     @relation("SupplyDiscrepanciaResueltaPor", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  resueltoAt    DateTime?
  aprobadoPorId String?
  aprobadoPor   User?     @relation("SupplyDiscrepanciaAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoAt    DateTime?

  documentos String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas           SupplyDiscrepanciaNota[]
  /// Ajuste generado al resolver, si lo hubo.
  cuentaPorPagar  SupplyCuentaPorPagar?    @relation("SupplyDiscrepanciaCxP")
  cuentaPorCobrar SupplyCuentaPorCobrar?   @relation("SupplyDiscrepanciaCxC")

  @@index([conciliacionId, estado])
  @@map("supply_discrepancias")
}

/// Comentario o documento adjunto durante la investigación. Nunca se borra.
model SupplyDiscrepanciaNota {
  id             String             @id @default(cuid())
  discrepanciaId String
  discrepancia   SupplyDiscrepancia @relation(fields: [discrepanciaId], references: [id], onDelete: Cascade)

  texto         String
  documentoPath String?

  actorId String?
  actor   User?   @relation("SupplyDiscrepanciaNotaActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([discrepanciaId, createdAt])
  @@map("supply_discrepancia_notas")
}

// ── Venta sin precompra (§14) ───────────────────────────────────────────────

enum SupplyVentaEstado {
  /// Abierta, esperando el pago del cliente a Membego.
  INICIADA
  /// Membego vio el dinero. El cliente puede recogerla.
  PAGADA
  /// El proveedor entregó. Aquí nace la cuenta por pagar.
  ENTREGADA
  CANCELADA
  /// Se devolvió el dinero al cliente después de pagada.
  REEMBOLSADA
}

/// VENTA A COMISIÓN. Membego vende RD$1.000 de un producto del proveedor sin
/// haberlo comprado. El cliente le paga a Membego; el proveedor entrega; y solo
/// entonces Membego le debe RD$900 (bruto − 10%). No toca lotes ni ledger de
/// cubetas: es otro modelo económico (§14: «no mezclar con lotes prepagados»).
model SupplyVentaDirecta {
  id     String @id @default(cuid())
  /// MBG-V-000001
  numero String @unique

  proveedorId    String
  proveedor      Company       @relation("SupplyProveedorVentas", fields: [proveedorId], references: [id], onDelete: Restrict)
  acuerdoId      String
  acuerdo        SupplyAcuerdo @relation(fields: [acuerdoId, proveedorId], references: [id, proveedorId], onDelete: Restrict)
  acuerdoVersion Int

  clienteId  String
  cliente    Cliente   @relation("SupplyVentaCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sucursalId String?
  sucursal   Sucursal? @relation("SupplyVentaSucursal", fields: [sucursalId], references: [id], onDelete: SetNull)

  estado SupplyVentaEstado @default(INICIADA)

  itemNombre         String
  varianteEtiqueta   String?
  cantidad           Int            @default(1)
  precioUnitario     Decimal        @db.Decimal(12, 2)
  montoBruto         Decimal        @db.Decimal(12, 2)
  /// Congelados al abrir la venta desde la versión del acuerdo.
  comisionPorcentaje Decimal        @db.Decimal(5, 2)
  comisionMonto      Decimal        @db.Decimal(12, 2)
  montoProveedor     Decimal        @db.Decimal(12, 2)
  /// Venta mixta (§17): un derecho del cliente cubre parte del valor. El
  /// cliente paga la diferencia; el GMV sigue siendo `montoBruto`.
  montoBono          Decimal        @default(0) @db.Decimal(12, 2)
  bonoDerechoId      String?        @unique
  bonoDerecho        SupplyDerecho? @relation("SupplyVentaBono", fields: [bonoDerechoId], references: [id], onDelete: SetNull)
  moneda             String         @default("DOP")

  /// Credencial al portador para recoger (24 bytes aleatorios). El escáner la
  /// acepta igual que un voucher, pero no toca ningún lote.
  codigoEntrega String @unique

  pagadaAt        DateTime?
  entregadaAt     DateTime?
  entregadaPorId  String?
  entregadaPor    User?     @relation("SupplyVentaEntregadaPor", fields: [entregadaPorId], references: [id], onDelete: SetNull)
  canceladaAt     DateTime?
  canceladaMotivo String?

  claveIdempotencia String? @unique
  meta              Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedido         SupplyPedido?
  cuentaPorPagar SupplyCuentaPorPagar?
  incidencias    SupplyIncidencia[]

  @@index([proveedorId, estado])
  @@index([clienteId, estado])
  @@index([acuerdoId, createdAt])
  @@index([estado, entregadaAt])
  @@map("supply_ventas_directas")
}
