// ──────────────────────────────────────────────────────────────────────────
// PASARELA DE PAGO
//
// El rastro de un cobro por pasarela, que ocurre FUERA de este servidor.
// Ver src/modules/pagos/intentos.ts y docs/runbooks/pagos-cardnet.md.
// ──────────────────────────────────────────────────────────────────────────

// ─── Pasarela de pago (CardNET) ──────────────────────────────────────────────

/// Un intento de cobro contra una pasarela externa.
///
/// POR QUÉ EXISTE: con transferencia, el "pago" era un comprobante que un
/// humano validaba. Con pasarela hay un ida y vuelta con un tercero, y hace
/// falta un registro propio para: (a) saber qué se intentó cobrar aunque el
/// cliente cierre el navegador a mitad, (b) que la confirmación sea IDEMPOTENTE
/// —una pasarela puede notificar el mismo pago dos veces y no se puede activar
/// dos veces—, y (c) conciliar contra el reporte del procesador.
///
/// `respuesta` guarda el payload crudo del retorno: ante una disputa, lo que
/// vale es lo que el procesador dijo, no nuestra interpretación.
model PagoIntento {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  /// 'CARDNET' | 'TRANSFERENCIA' | … (PaymentProviderKind, validado en código).
  proveedor String

  /// Qué se está pagando. Uno de los dos, según el tipo.
  compraId     String?
  compra       ProductoCompra? @relation(fields: [compraId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  /// La venta (libro de transacciones) que dejó este cobro aprobado. Ver `Transaction.pagoIntentoId`.
  transaccion  Transaction?
  /// Por dónde entró el cobro: APP (la app del cliente), WEB o RENOVACION_AUTOMATICA (tarjeta guardada). Nulo en
  /// los intentos anteriores al sprint de comprobantes (CHECK `pago_intentos_canal`).
  canal        String?
  /// Solo en el cobro de un CAMBIO DE PLAN: el plan que el cliente pidió y pagó cuando se creó el intento. La entrega
  /// aplica ESE plan y solo si la membresía sigue pidiéndolo; si el cliente cambió el pedido a mitad, no se aplica a ciegas.
  planDestinoId String?
  planDestino   Plan?   @relation("PagoIntentoPlanDestino", fields: [planDestinoId], references: [id], onDelete: SetNull)

  monto  Decimal @db.Decimal(10, 2)
  moneda String  @default("DOP")

  /// 'CREADO' | 'REDIRIGIDO' | 'APROBADO' | 'RECHAZADO' | 'EXPIRADO' | 'ERROR'.
  estado String @default("CREADO")

  /// Identificador de la sesión/transacción en la pasarela (para conciliar).
  referenciaExterna String?
  /// Purchase.UniqueID de CardNET para el flujo móvil. Se genera y persiste
  /// antes del POST al proveedor para que cada reconciliación use la misma
  /// identidad idempotente.
  cardnetUniqueId    String? @unique
  /// Código de autorización que devuelve el procesador cuando aprueba.
  autorizacion      String?
  /// Motivo del rechazo, tal como lo reporta la pasarela.
  motivoRechazo     String?
  /// Payload crudo del retorno. Evidencia ante disputas.
  respuesta         Json?

  /// Se llena cuando el PROCESADOR confirmó el cobro. Es el reclamo de
  /// idempotencia del CARGO: si tiene fecha, una notificación repetida no
  /// vuelve a contar el mismo cobro. NO significa producto entregado (ver
  /// `fulfillmentEstado`).
  activadoAt DateTime?

  /// CUMPLIMIENTO separado del cobro (P1B). 'PENDIENTE' = cobrado sin
  /// entregar · 'COMPLETADA' = producto activo + fulfillmentAt ·
  /// 'FALLIDA' = cobrado con entrega fallida (+ fulfillmentError) → caso de
  /// conciliación y reintento, nunca éxito para el cliente · 'DESCARTADA' =
  /// una persona lo cerró SIN entregar desde la conciliación (motivo y nota en
  /// la bitácora); estado final y sin venta.
  fulfillmentEstado   String    @default("PENDIENTE")
  fulfillmentAt       DateTime?
  fulfillmentError    String?
  fulfillmentIntentos Int       @default(0)

  cardnetCaptureSession CardnetCaptureSession?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, estado, createdAt])
  @@index([referenciaExterna])
  @@index([compraId])
  @@index([membershipId])
  @@map("pago_intentos")
}

/// Estado durable del checkout móvil CardNET. `reservationKey` gana una única
/// sesión de captura por ficha de cliente y empresa; se vuelve null al liberar
/// el slot después de una transición terminal.
model CardnetCaptureSession {
  id                String   @id
  authSubject       String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  customerId        String?
  membershipId      String?
  membership        Membership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  compraId          String?
  compra            ProductoCompra? @relation(fields: [compraId], references: [id], onDelete: Cascade)
  /// Plan que se está pagando cuando la sesión es de un cambio de plan (pasa tal cual al intento de compra).
  planDestinoId     String?
  planDestino       Plan?    @relation("CapturaPlanDestino", fields: [planDestinoId], references: [id], onDelete: SetNull)
  monto             Decimal  @db.Decimal(10, 2)
  moneda            String   @default("DOP")
  estado            String   @default("STARTING")
  reservaClienteKey String?  @unique
  captureNonce      String?
  captureUrl        String?
  scriptUrl         String?
  publicKey         String?
  customerUniqueId  String?
  /// Identificadores de perfil previos, sin guardar tokens reutilizables.
  perfilBase        Json?
  paymentProfileId  String?
  /// Consentimiento explícito para guardar el medio de pago. No autoriza renovaciones.
  guardarTarjeta    Boolean  @default(false)
  /// Consentimiento histórico del flujo anterior. Se conserva para auditoría;
  /// nunca se usa como autorización para guardar tarjeta o renovar.
  guardarRenovacion  Boolean  @default(false)
  purchaseIntentId  String? @unique
  purchaseIntent    PagoIntento? @relation(fields: [purchaseIntentId], references: [id], onDelete: SetNull)
  tarjetaTokenizada TarjetaTokenizada?
  capturadoAt       DateTime?
  perfilLeidoAt     DateTime?
  conciliadoAt      DateTime?
  asociadoAt        DateTime?
  venceAt           DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([authSubject, createdAt])
  @@index([companyId, clienteId, estado])
  @@index([estado, venceAt])
  @@map("cardnet_capture_sessions")
}

// ─── Consentimiento sobre la tarjeta ─────────────────────────────────────────

/// Lo que el cliente aceptó sobre su tarjeta, con la prueba de cuándo y bajo
/// qué texto. GUARDAR la tarjeta y RENOVAR automáticamente son DOS
/// consentimientos distintos con DOS operaciones distintas: el primero permite
/// pagos que el cliente inicia; el segundo permite cobros SIN él.
///
/// Solo se inserta. Lo único que se modifica de una fila es `revocadoAt`, y una
/// sola vez: retirar el consentimiento no borra que existió. Ante una disputa o
/// un contracargo, esta fila es la evidencia.
///
/// Índices únicos parciales (solo en la migración `20261077_consentimientos_pago`,
/// Prisma no los expresa):
///   · UNIQUE (tipo, tarjetaId) WHERE vigente y sin membresía — un consentimiento
///     de guardar vigente por tarjeta.
///   · UNIQUE (tipo, membershipId) WHERE vigente — uno de renovar por membresía.
model ConsentimientoPago {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// 'GUARDAR_TARJETA' | 'RENOVACION_AUTOMATICA' (validado en código y por CHECK).
  tipo String

  /// A qué tarjeta se refiere. La fila sobrevive si la tarjeta se borra.
  tarjetaId    String?
  tarjeta      TarjetaTokenizada? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  /// A qué membresía, cuando el consentimiento es de renovar.
  membershipId String?
  membership   Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  /// 'CLIENTE' = lo aceptó en pantalla. 'HEREDADO' = la tarjeta o la renovación
  /// existían antes de que hubiera este registro: se asume el consentimiento que
  /// la pantalla de entonces pedía, y queda marcado para poder pedir una
  /// reconfirmación.
  origen       String @default("CLIENTE")
  /// Identificador del texto que se le mostró (el texto vive en código, por
  /// versión, y una versión publicada no se edita). Heredados: 'previo-a-registro'.
  textoVersion String

  otorgadoAt DateTime  @default(now())
  revocadoAt DateTime?

  ipAddress String?
  userAgent String?

  @@index([companyId])
  @@index([clienteId, tipo, revocadoAt])
  @@index([tarjetaId])
  @@index([membershipId, tipo])
  @@map("consentimientos_pago")
}
