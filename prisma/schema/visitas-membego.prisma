// ──────────────────────────────────────────────────────────────────────────
// SUPPLIER & FULFILLMENT COMMERCE · VISITA ATRIBUIDA A MEMBEGO (§22–§38)
//
// Cuando un cliente llega a un negocio POR Membego (canjea un derecho de
// Supply, recoge un pedido del marketplace, usa una oferta) se abre una
// VISITA: quién, dónde, por qué vino, qué incluía Membego y qué compró de más.
// Lo que compró de más son VENTAS ADICIONALES (ancillary sales), y sobre esa
// base —y SOLO sobre esa base— Membego cobra su comisión al negocio.
//
// Lo que NO es esto:
//   · No es la visita de membresía (`Visit`, `membresias.prisma`): aquella
//     descuenta un lavado de un plan; esta atribuye una llegada a Membego.
//   · No es Supply Economics: la unidad que Membego compró y el cliente
//     canjeó vive en el ledger de lotes y en la redención; aquí solo se
//     referencia (`redemptionId`). Nunca se vuelve a cobrar comisión por ella.
//   · No es un segundo libro: la comisión se asienta en el libro de Merchant
//     Billing de la empresa (`merchant_ledger_entries`, tipo ANCILLARY_FEE,
//     referencia ANCILLARY_SALE). Aquí queda el documento (la venta) y los
//     enlaces a sus asientos, igual que `Commission` lo hace con un pedido.
//
// Evidencia de una venta adicional (§32): lo que teclea el operador es
// MERCHANT_REPORTED; el cliente que confirma la sube a CUSTOMER_CONFIRMED;
// PAYMENT_VERIFIED y FISCALLY_RECONCILED solo las pone una fuente externa.
// Nada se borra: disputas y reversas se resuelven con asientos nuevos.
//
// Toda tabla lleva `companyId` (RLS por empresa) y FK compuestas con la
// empresa donde hay relación con otra tabla de empresa.
// ──────────────────────────────────────────────────────────────────────────

enum MembegoVisitOrigin {
  MEMBEGO_SUPPLY
  MARKETPLACE_ORDER
  DEAL_CLAIM
}

enum MembegoVisitStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum AncillarySaleStatus {
  REPORTED
  CONFIRMED
  DISPUTED
  ADJUSTED
  REVERSED
}

/// Nivel de evidencia de una venta adicional (§32). Una confirmación del
/// cliente NO es evidencia de pago de un procesador.
enum AncillaryEvidenceLevel {
  MERCHANT_REPORTED
  CUSTOMER_CONFIRMED
  PAYMENT_VERIFIED
  FISCALLY_RECONCILED
}

enum AncillaryCommissionStatus {
  NOT_APPLICABLE
  PENDING
  POSTED
  REVERSED
}

enum AncillarySaleLineKind {
  /// Del mini catálogo del proveedor: el precio lo relee el servidor (§55).
  CATALOG_ITEM
  /// Línea personalizada: el operador escribe descripción y precio; queda marcada y auditada (§26, §55).
  CUSTOM_REPORTED_LINE
}

enum VisitDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_MERCHANT
  RESOLVED_CUSTOMER
  DISMISSED
}

model MembegoVisit {
  id     String @id @default(cuid())
  /// "MBG-VI-2026-000001".
  number String @unique

  /// La empresa donde ocurre (fulfillment partner): la del proveedor o el Merchant.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Si el origen es Supply: el proveedor que entrega.
  supplierId String?
  supplier   SupplyV2Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  locationId String?
  location   Sucursal? @relation(fields: [locationId, companyId], references: [id, companyId], onDelete: Restrict)

  /// El cliente de la plataforma (cuenta de la app).
  customerUserId String
  customer       User   @relation("MembegoVisitCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)

  origin             MembegoVisitOrigin
  attributionChannel MembegoAttributionChannel?

  /// Documento que trajo al cliente: ENTITLEMENT (Supply), MEMBEGO_ORDER, DEAL_CLAIM.
  sourceType String
  sourceId   String

  /// Supply: la redención que abrió la visita (una visita por redención).
  redemptionId String?             @unique
  redemption   SupplyV2Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  /// Marketplace: el pedido que abrió la visita (una visita por pedido).
  orderId String?       @unique
  order   MembegoOrder? @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)

  status MembegoVisitStatus @default(OPEN)

  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  openedByUserId String?
  openedBy       User?     @relation("MembegoVisitOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedByUserId String?
  closedBy       User?     @relation("MembegoVisitClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  // ── Política contractual congelada al abrir (§37–§38) ──
  ancillaryCommissionEnabled   Boolean  @default(true)
  ancillaryCommissionRate      Decimal  @default(0) @db.Decimal(5, 2)
  attributionWindowMinutes     Int      @default(120)
  requiresCustomerConfirmation Boolean  @default(false)
  receiptRequiredAbove         Decimal? @db.Decimal(12, 2)
  currency                     String   @default("DOP")
  agreementId                  String?
  agreementVersionId           String?

  // ── Caché de totales (la verdad son las ventas y el libro) ──
  ancillaryTotal  Decimal @default(0) @db.Decimal(14, 2)
  commissionTotal Decimal @default(0) @db.Decimal(14, 2)

  /// Confirmación del cliente sobre el total reportado (§33). No es evidencia de pago.
  customerConfirmedAt    DateTime?
  customerConfirmedTotal Decimal?  @db.Decimal(14, 2)

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    AncillarySale[]
  disputes VisitDispute[]

  @@unique([id, companyId])
  @@unique([orderId, companyId])
  @@index([companyId, openedAt])
  @@index([companyId, status])
  @@index([supplierId, openedAt])
  @@index([customerUserId, openedAt])
  @@map("membego_visits")
}

model AncillarySale {
  id     String @id @default(cuid())
  /// "MBG-VA-2026-000001".
  number String @unique

  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  visitId   String
  visit     MembegoVisit @relation(fields: [visitId, companyId], references: [id, companyId], onDelete: Restrict)

  status        AncillarySaleStatus    @default(REPORTED)
  evidenceLevel AncillaryEvidenceLevel @default(MERCHANT_REPORTED)

  /// Lo que el cliente pagó de más al negocio, según se reportó.
  subtotal Decimal @db.Decimal(14, 2)
  currency String  @default("DOP")

  /// Base comisionable (= subtotal; nunca incluye la unidad de Membego) y la comisión calculada con la tasa congelada.
  commissionBase   Decimal @db.Decimal(14, 2)
  commissionRate   Decimal @db.Decimal(5, 2)
  commissionAmount Decimal @db.Decimal(14, 2)

  commissionStatus AncillaryCommissionStatus @default(PENDING)
  /// Asiento ANCILLARY_FEE en el libro de Merchant Billing (1:1).
  ledgerEntryId String?              @unique
  ledgerEntry   MerchantLedgerEntry? @relation("AncillarySaleCharge", fields: [ledgerEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  /// Asiento REFUND que revierte la comisión completa.
  reversalEntryId String?              @unique
  reversalEntry   MerchantLedgerEntry? @relation("AncillarySaleReversal", fields: [reversalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  /// Asiento ADJUSTMENT por la resolución de una disputa (parcial).
  adjustmentEntryId String?              @unique
  adjustmentEntry   MerchantLedgerEntry? @relation("AncillarySaleAdjustment", fields: [adjustmentEntryId, companyId], references: [id, companyId], onDelete: Restrict)

  /// Alguna línea es personalizada (precio del operador): a revisar.
  hasCustomLines Boolean @default(false)

  reportedByUserId String
  reportedBy       User     @relation("AncillarySaleReportedBy", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  reportedAt       DateTime @default(now())

  customerConfirmedAt DateTime?
  /// Evidencia externa (pasarela/banco): fecha y referencia. Nunca la escribe el negocio.
  paymentVerifiedAt      DateTime?
  paymentVerificationRef String?

  reversedAt       DateTime?
  reversedByUserId String?
  reversedBy       User?     @relation("AncillarySaleReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?

  idempotencyKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines   AncillarySaleLine[]
  dispute VisitDispute?

  @@unique([companyId, idempotencyKey])
  @@unique([id, companyId])
  @@unique([ledgerEntryId, companyId])
  @@unique([reversalEntryId, companyId])
  @@unique([adjustmentEntryId, companyId])
  @@index([visitId])
  @@index([companyId, reportedAt])
  @@index([companyId, status])
  @@map("ancillary_sales")
}

/// Línea de una venta adicional. INMUTABLE (disparador): corregir es revertir y volver a registrar.
model AncillarySaleLine {
  id        String        @id @default(cuid())
  companyId String
  saleId    String
  sale      AncillarySale @relation(fields: [saleId, companyId], references: [id, companyId], onDelete: Restrict)

  kind AncillarySaleLineKind

  /// Del mini catálogo del proveedor (`sellableAsExtra`): el precio se releyó del servidor.
  supplyCatalogItemId String?
  supplyCatalogItem   SupplyV2CatalogItem? @relation(fields: [supplyCatalogItemId], references: [id], onDelete: Restrict)

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  /// CATALOG (precio del servidor) u OPERATOR (precio tecleado, línea personalizada).
  priceSource String

  @@index([saleId])
  @@index([companyId])
  @@map("ancillary_sale_lines")
}

/// Disputa del cliente sobre una visita o una de sus ventas (§34). La venta no se borra.
model VisitDispute {
  id String @id @default(cuid())

  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  visitId   String
  visit     MembegoVisit @relation(fields: [visitId, companyId], references: [id, companyId], onDelete: Restrict)
  /// Si disputa una venta concreta (una disputa viva por venta).
  saleId String?        @unique
  sale   AncillarySale? @relation(fields: [saleId, companyId], references: [id, companyId], onDelete: Restrict)

  customerUserId String
  customer       User   @relation("VisitDisputeCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)

  status VisitDisputeStatus @default(OPEN)

  /// Lo que dice el cliente («No compré ese producto», «Solo compré RD$150»).
  customerClaim String
  /// Lo que el cliente reconoce haber pagado (null = no lo dijo).
  claimedTotal  Decimal? @db.Decimal(14, 2)
  /// Lo reportado por el negocio cuando se abrió la disputa.
  reportedTotal Decimal  @db.Decimal(14, 2)

  resolution       String?
  resolvedByUserId String?
  resolvedBy       User?     @relation("VisitDisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  /// La base que quedó reconocida tras resolver (para el ajuste del libro).
  resolvedBase     Decimal?  @db.Decimal(14, 2)

  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([saleId, companyId])
  @@index([companyId, status])
  @@index([visitId])
  @@map("visit_disputes")
}
