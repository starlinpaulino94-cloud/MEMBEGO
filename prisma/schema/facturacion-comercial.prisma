// ─────────────────────────────────────────────────────────────────────────────
// COMMERCE CORE · MERCHANT BILLING (Fase 4 del Plan Maestro)
//
// Lo que cada EMPRESA le debe a Membego por los pedidos que la plataforma le
// trajo: la comisión de cada pedido completado, el estado de cuenta corrido y el
// límite de crédito. Es la dirección empresa → Membego.
//
//   · `MerchantBillingConfig`  cómo cobra Membego a esta empresa (1:1).
//   · `Commission`             la comisión de UN pedido (única por pedido).
//   · `MerchantLedgerEntry`    el libro de la cuenta: APPEND-ONLY, con saldo corrido.
//   · `MerchantStatement`      el corte de un periodo: inmutable, uno por periodo.
//
// SEPARACIÓN ESTRICTA de Supply Economics (Membego → proveedor, `supply_v2_*`):
// ninguna tabla de aquí referencia una de Supply ni al revés, y el libro de la
// cuenta rechaza en la base cualquier referencia que no sea de este dominio. Un
// pedido que envuelve una compra de Supply (origen SUPPLY) NO genera comisión: lo
// que Membego gana ahí se liquida por el lado de Supply.
//
// LA BASE HACE CUMPLIR (migración `20261044_merchant_billing`): el libro no se
// edita ni se borra, el saldo de cada asiento es el anterior más su monto, la
// comisión coincide con su asiento y con el pedido que la origina, y el corte
// cuadra con sus propias cifras.
//
// AISLAMIENTO. Las cuatro tablas llevan `companyId` propio y las FK entre ellas y
// hacia el pedido son COMPUESTAS `(id, companyId)`.
// ─────────────────────────────────────────────────────────────────────────────

enum MerchantFeeModel {
  CPA_FIXED
  PERCENTAGE
  /// CPA mientras el pedido no tenga el pago verificado; porcentaje desde `PAYMENT_VERIFIED`.
  HYBRID
}

enum MerchantBillingCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum MerchantBillingStatus {
  ACTIVE
  /// Debe más que su límite de crédito: tiene un plazo para ponerse al día.
  GRACE_PERIOD
  SUSPENDED
}

enum MerchantCommissionType {
  CPA_FIXED
  PERCENTAGE
}

enum MerchantCommissionStatus {
  CONFIRMED
  REVERSED
}

/// Signo del monto (positivo = la empresa debe; negativo = a su favor):
/// `REDEMPTION_FEE`, `ORDER_FEE` > 0; `REFUND`, `PAYMENT`, `CREDIT`,
/// `PROMOTIONAL_CREDIT` < 0; `ADJUSTMENT` y `VERIFICATION_ADJUSTMENT`
/// cualquiera ≠ 0, con motivo.
///
/// `VERIFICATION_ADJUSTMENT`: cuando un pago se VERIFICA (fuente externa) después
/// de que la comisión CPA ya se cobró, el modelo HYBRID debe cobrar el porcentaje.
/// La comisión original no se edita: se asienta la DIFERENCIA (porcentaje − CPA),
/// una sola vez por comisión, con la referencia del hecho que la verificó. Lo
/// escribe solo el sistema (`commission:<pedido>:verification`).
enum MerchantLedgerEntryType {
  REDEMPTION_FEE
  ORDER_FEE
  REFUND
  ADJUSTMENT
  PAYMENT
  CREDIT
  PROMOTIONAL_CREDIT
  VERIFICATION_ADJUSTMENT
}

model MerchantBillingConfig {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  feeModel        MerchantFeeModel     @default(HYBRID)
  /// Lo que se cobra por pedido cuando aplica el CPA.
  cpaAmount       Decimal              @default(100) @db.Decimal(12, 2)
  /// Porcentaje sobre la base comisionable cuando aplica el porcentaje (0–100).
  percentageRate  Decimal              @default(8) @db.Decimal(5, 2)
  /// Lo máximo que la empresa puede deber antes de entrar en gracia.
  creditLimit     Decimal              @default(5000) @db.Decimal(12, 2)
  billingCycle    MerchantBillingCycle @default(MONTHLY)
  currency        String               @default("DOP")

  status        MerchantBillingStatus @default(ACTIVE)
  /// Hasta cuándo dura la gracia (solo en `GRACE_PERIOD`).
  graceUntil    DateTime?
  /// El superadmin puso la cuenta en este estado a mano: el sistema no la reactiva ni la suspende.
  holdManual    Boolean               @default(false)
  statusReason  String?
  statusChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Destino de la FK compuesta de los hijos.
  @@unique([id, companyId])
  @@map("merchant_billing_configs")
}

/// La comisión de un pedido. Se escribe en la MISMA transacción que cierra el
/// pedido, junto a su asiento del libro; solo cambia de CONFIRMED a REVERSED (con
/// su asiento de reverso) cuando el pedido se reembolsa.
model Commission {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  orderId String       @unique
  order   MembegoOrder @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)

  type   MerchantCommissionType
  status MerchantCommissionStatus @default(CONFIRMED)

  /// Fotos de lo que decidió la comisión (la config y el pedido cambian; esto no).
  feeModel          MerchantFeeModel
  verificationLevel MembegoVerificationLevel
  /// La base comisionable del pedido (GMV sin impuestos).
  baseAmount        Decimal                  @db.Decimal(12, 2)
  /// Solo en PERCENTAGE.
  rate              Decimal?                 @db.Decimal(5, 2)
  /// Si la comisión es la CUOTA de una oferta con presupuesto (Fase 5): el id de la
  /// oferta (texto opaco, sin FK: Merchant Billing no depende de las ofertas). Una
  /// cuota de oferta es siempre CPA, sea cual sea el modelo de cobro de la empresa.
  dealId            String?
  amount            Decimal                  @db.Decimal(12, 2)
  currency          String                   @default("DOP")

  /// El asiento que cobra la comisión (1:1) y, si se revirtió, el que la devuelve.
  ledgerEntryId   String
  ledgerEntry     MerchantLedgerEntry  @relation("CommissionCharge", fields: [ledgerEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversalEntryId String?
  reversalEntry   MerchantLedgerEntry? @relation("CommissionReversal", fields: [reversalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversedAt      DateTime?

  /// AJUSTE POR VERIFICACIÓN (a lo sumo uno, append-only). Si el pago se verificó
  /// DESPUÉS de cobrar el CPA (modelo HYBRID, sin cuota de oferta), aquí queda la
  /// diferencia asentada (porcentaje − CPA, con signo), el asiento que la cobra, la
  /// referencia externa que la justificó y, si el pedido se reembolsó después, el
  /// asiento que la devuelve. `amount` (lo cobrado al cerrar) NO cambia nunca: lo
  /// cobrado en total es `amount + verificationAdjustmentAmount`. La base exige
  /// (`merchant_commissions_ajuste_verificacion` + disparador) que el ajuste vaya
  /// con su asiento, que sea de una comisión CPA sin oferta y que no se repita.
  verificationAdjustmentAmount          Decimal?             @db.Decimal(12, 2)
  verificationAdjustmentEntryId         String?
  verificationAdjustmentEntry           MerchantLedgerEntry? @relation("CommissionVerificationAdjustment", fields: [verificationAdjustmentEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  verificationAdjustedAt                DateTime?
  verificationRef                       String?
  verificationAdjustmentReversalEntryId String?
  verificationAdjustmentReversalEntry   MerchantLedgerEntry? @relation("CommissionVerificationAdjustmentReversal", fields: [verificationAdjustmentReversalEntryId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, companyId])
  @@unique([ledgerEntryId])
  @@unique([ledgerEntryId, companyId])
  @@unique([reversalEntryId])
  @@unique([reversalEntryId, companyId])
  @@unique([verificationAdjustmentEntryId])
  @@unique([verificationAdjustmentEntryId, companyId])
  @@unique([verificationAdjustmentReversalEntryId])
  @@unique([verificationAdjustmentReversalEntryId, companyId])
  @@unique([id, companyId])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([dealId])
  @@map("merchant_commissions")
}

/// APPEND-ONLY: la base rechaza UPDATE, DELETE y TRUNCATE. Un error se corrige con
/// un asiento nuevo que lo contraría, nunca editando. `balance` es el saldo
/// corrido de la cuenta DESPUÉS de este asiento y la base comprueba que sea el
/// anterior más `amount`.
model MerchantLedgerEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Posición en la cuenta de la empresa: 1, 2, 3… sin huecos.
  seq     Int
  type    MerchantLedgerEntryType
  /// Positivo = la empresa debe más; negativo = a su favor.
  amount  Decimal                 @db.Decimal(14, 2)
  balance Decimal                 @db.Decimal(14, 2)
  currency String                 @default("DOP")

  /// A qué se debe: `COMMISSION` (id de la comisión), `PAYMENT` (referencia del
  /// pago), `MANUAL` o `STATEMENT`. La base rechaza cualquier otra cosa (en
  /// particular, nada de Supply).
  referenceType String
  referenceId   String
  reason        String?
  /// Reintentar el MISMO asiento no lo duplica. Único por empresa.
  idempotencyKey String
  /// Quién lo registró (null = sistema). Sin FK: un usuario que se borra no reescribe la historia.
  actorUserId   String?

  createdAt DateTime @default(now())

  charges   Commission? @relation("CommissionCharge")
  reversals Commission? @relation("CommissionReversal")
  verificationAdjustments         Commission? @relation("CommissionVerificationAdjustment")
  verificationAdjustmentReversals Commission? @relation("CommissionVerificationAdjustmentReversal")

  @@unique([companyId, seq])
  @@unique([companyId, idempotencyKey])
  @@unique([id, companyId])
  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@map("merchant_ledger_entries")
}

/// El corte de un periodo, INMUTABLE y único por (empresa, periodo): generarlo dos
/// veces devuelve el primero. `period` = `<inicio>/<fin>` en fechas de Santo
/// Domingo (inicio incluido, fin excluido).
model MerchantStatement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  period       String
  periodStart  DateTime
  periodEnd    DateTime
  billingCycle MerchantBillingCycle
  currency     String               @default("DOP")

  openingBalance   Decimal @db.Decimal(14, 2)
  totalOrders      Int
  /// Σ base comisionable de los pedidos cobrados en el periodo.
  totalGmv         Decimal @db.Decimal(14, 2)
  /// Σ comisiones cobradas (REDEMPTION_FEE + ORDER_FEE).
  totalCommissions Decimal @db.Decimal(14, 2)
  /// Σ reversos de comisión (REFUND, negativo).
  reversals        Decimal @db.Decimal(14, 2)
  adjustments      Decimal @db.Decimal(14, 2)
  /// Σ CREDIT + PROMOTIONAL_CREDIT (negativo).
  credits          Decimal @db.Decimal(14, 2)
  /// Σ PAYMENT (negativo).
  payments         Decimal @db.Decimal(14, 2)
  closingBalance   Decimal @db.Decimal(14, 2)
  /// `max(closingBalance, 0)`: lo que la empresa debe al cierre.
  amountDue        Decimal @db.Decimal(14, 2)
  entryCount       Int

  generatedAt DateTime @default(now())

  @@unique([companyId, period])
  @@unique([id, companyId])
  @@index([companyId, periodEnd])
  @@map("merchant_statements")
}
