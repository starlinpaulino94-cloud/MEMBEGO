{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "server-only": ["./scripts/verificacion/server-only.ts"],
      "@membego/ui/*": ["./packages/ui/src/*"],
      "@membego/contracts": ["./packages/contracts/src/index.ts"],
      "@membego/contracts/*": ["./packages/contracts/src/*"],
      "@membego/platform-sdk": ["./packages/platform-sdk/src/index.ts"],
      "@membego/platform-sdk/*": ["./packages/platform-sdk/src/*"],
      "@/components/ui/*": ["./packages/ui/src/ui/*"],
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/services/*": ["./src/services/*"],
      "@/config/*": ["./src/config/*"],
      "@/types/*": ["./src/types/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  }
}
