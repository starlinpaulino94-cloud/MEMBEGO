{
  "expo": {
    "name": "MembeGo",
    "slug": "membego",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "membego",
    "userInterfaceStyle": "light",
    "ios" : {
      "bundleIdentifier": "com.havelgo.membego",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "MembeGo necesita acceso a tu galería para adjuntar comprobantes de pago de tus membresías.",
        "NSLocationWhenInUseUsageDescription": "MembeGo utiliza tu ubicación para mostrarte los comercios afiliados, servicios y ofertas más cercanos a ti en el mapa."
      }
    },
    "android": {
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.havelgo.membego"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MembeGo utiliza tu ubicación para mostrarte los comercios afiliados, servicios y ofertas más cercanos a ti en el mapa."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc01217c-3f1f-4293-a64f-5e33fafe8aa5"
      }
    },
    "owner": "havelgo"
  }
}
