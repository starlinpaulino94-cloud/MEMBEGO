# ============================================================
# MEMBEGO PLATFORM — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a Git
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# Obtén estas URLs desde: Supabase → Settings → Database → Connection string
# ------------------------------------------------------------

# Transaction pooler — usa pgBouncer, ideal para serverless (Prisma en prod)
# IMPORTANTE: incluye SIEMPRE `connection_limit` y `pool_timeout`. Sin
# connection_limit, cada instancia serverless abre num_cpus*2+1 conexiones;
# con varias instancias calientes se agota el pool de pgBouncer y aparecen
# errores intermitentes (P2024) en toda la app. En Vercel usa connection_limit=1.
# Formato: postgresql://postgres.XXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20
DATABASE_URL=""

# Direct connection — sin pgBouncer, solo para migraciones (prisma migrate)
# Formato: postgresql://postgres.XXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ------------------------------------------------------------
# SUPABASE AUTH
# Obtén estas claves desde: Supabase → Settings → API
# ------------------------------------------------------------

# URL del proyecto Supabase (pública, va al frontend)
NEXT_PUBLIC_SUPABASE_URL=""

# Clave anon/pública (safe para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave service_role (PRIVADA — solo backend/server actions)
SUPABASE_SERVICE_ROLE_KEY=""

# JWT Secret del proyecto (PRIVADA) — Supabase → Settings → API → JWT settings.
# Permite verificar localmente la firma del access token en el middleware y en
# el servidor, sin llamadas de red a Auth. Opcional por ahora: si falta, la app
# sigue usando la validación remota de la SDK.
SUPABASE_JWT_SECRET=""

# ------------------------------------------------------------
# DOMINIO Y MARCA (MembeGo)
# ------------------------------------------------------------

# URL base oficial de producción. Se usa para metadata/OG/canonical, sitemap,
# enlaces de referido y correos. Sin barra final.
NEXT_PUBLIC_APP_URL="https://membego.com"

# FASE 2 · Separación Landing / Aplicación (opcionales, para el futuro).
# Mientras estén vacías, todo usa NEXT_PUBLIC_APP_URL (dominio único, sin cambio
# de comportamiento). Al separar los proyectos, definir:
#   NEXT_PUBLIC_LANDING_URL  → dominio de la Landing (marketing/SEO), ej. https://membego.com
#   NEXT_PUBLIC_APP_ORIGIN   → dominio de la Aplicación,             ej. https://app.membego.com
# NEXT_PUBLIC_LANDING_URL="https://membego.com"
# NEXT_PUBLIC_APP_ORIGIN="https://app.membego.com"
# Etapa 6 · dominio de la cookie de sesión para SSO entre subdominios
# (membego.com ↔ app.membego.com). VACÍO = cookie host-only (comportamiento
# actual, sin cambios). NO fijarlo en local ni previews (host distinto rompe la
# sesión). Definir SOLO en producción cuando los dominios estén separados:
# NEXT_PUBLIC_COOKIE_DOMAIN=".membego.com"

# ------------------------------------------------------------
# CORREO (Resend)
# ------------------------------------------------------------

# Remitente de los correos del sistema. El dominio membego.com debe estar
# verificado en Resend (DNS) para que el envío funcione.
EMAIL_FROM="MembeGo <no-reply@membego.com>"

# API key de Resend (privada). Sin ella, el envío de correo queda deshabilitado.
RESEND_API_KEY=""

# ------------------------------------------------------------
# VERIFICACIÓN DE CORREO EN EL REGISTRO (Onboarding Fase 1 · O-1)
# ------------------------------------------------------------

# "true" activa la verificación de correo: el registro crea la cuenta SIN
# confirmar y envía un enlace de confirmación con marca propia vía Resend
# (ruta /confirmar). Con cualquier otro valor (default) el registro se
# auto-confirma como hasta ahora.
#
# IMPORTANTE: para que la verificación realmente BLOQUEE el acceso hasta
# confirmar, además de este flag hay que activar en Supabase → Authentication
# → Providers → Email la opción "Confirm email". Ambos van de la mano.
# Requiere RESEND_API_KEY configurada. Validar en staging antes de activar en
# producción.
EMAIL_VERIFICATION_ENABLED=""

# ------------------------------------------------------------
# LOGIN SOCIAL CON GOOGLE (Onboarding Fase 5 · O-16)
# ------------------------------------------------------------

# "true" muestra el botón "Continuar con Google" en login y registro, y activa
# la ruta de callback /auth/callback. Con cualquier otro valor (default) el
# login social queda oculto y la app funciona solo con correo/contraseña.
#
# Antes de activarlo hay que configurar el proveedor en DOS lugares:
#   1) Google Cloud → APIs & Services → Credentials → OAuth client ID (Web):
#      - Authorized redirect URI: https://<TU-PROYECTO>.supabase.co/auth/v1/callback
#      - Copia el Client ID y el Client Secret.
#   2) Supabase → Authentication → Providers → Google: pega el Client ID/Secret
#      y habilítalo. En Authentication → URL Configuration agrega a "Redirect
#      URLs" tu dominio + /auth/callback (p. ej. https://membego.com/auth/callback).
#
# El flag es NEXT_PUBLIC_* porque el botón se renderiza en el cliente. Validar
# el flujo completo en staging antes de activarlo en producción (no se puede
# probar OAuth sin credenciales reales).
#
# SEGURIDAD — enlace de identidades: si Supabase tiene el enlace automático de
# identidades activo, un login con Google cuyo correo (verificado por Google)
# coincida con una cuenta de contraseña existente ENTRA en esa cuenta. Eso es
# el comportamiento estándar del sector, pero abre un vector si el registro
# por contraseña NO verifica el correo: alguien podría pre-registrar una
# cuenta con el correo de otra persona y heredar acceso cuando esta entre con
# Google. Por eso: activar EMAIL_VERIFICATION_ENABLED (y "Confirm email" en
# Supabase) ANTES o junto con este flag.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# ------------------------------------------------------------
# ENDPOINTS DE ARRANQUE / OPERACIÓN (sensibles)
# Usados por /api/bootstrap-superadmin y /api/admin-reset-password para crear el
# primer SUPERADMIN o reparar contraseñas. Apagados por defecto.
# ------------------------------------------------------------

# Habilita los endpoints de bootstrap. Déjalo SIN definir (o en "false") en
# operación normal. Ponlo en "true" solo mientras haces el arranque inicial y
# vuélvelo a apagar al terminar. Sin esto, los endpoints responden 404.
BOOTSTRAP_ENABLED=""

# Secreto para autorizar los endpoints de bootstrap (header x-bootstrap-secret).
# Debe tener al menos 24 caracteres. Genera uno aleatorio y no lo reutilices.
BOOTSTRAP_SECRET=""

# ------------------------------------------------------------
# SENTRY (monitoreo de errores) — opcional
# Si no configuras el DSN, Sentry queda inactivo (la app funciona igual).
# Obtén el DSN en: Sentry → Settings → Projects → membego → Client Keys (DSN)
# ------------------------------------------------------------

# DSN del proyecto. Va tanto al servidor como al cliente (usa el mismo valor).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Entorno reportado a Sentry (production / staging / development).
# Si se omite, se usa VERCEL_ENV y si no 'development'.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Release para asociar errores a una versión (opcional; por defecto el SHA de git).
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""

# Token para subir source maps en el build (privado). Solo necesario en CI/deploy.
# Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=""

# ------------------------------------------------------------
# GEOLOCALIZACIÓN (Fase 1 · docs/GEOLOCALIZACION.md)
# ------------------------------------------------------------

# Proveedor de geocodificación: "geoapify" (default) | "nominatim" | "mock"
# (SÓLO en desarrollo). Las claves privadas NUNCA van al navegador: todo el
# módulo geo se ejecuta en server actions / server-only.
GEOCODING_PROVIDER="geoapify"

# API key de Geoapify (privada). Se obtiene en https://geoapify.com
# Sin ella, la geocodificación por Geoapify falla (ver docs §6.3) hasta que se
# configure; en local se puede usar GEOCODING_PROVIDER="nominatim".
GEOAPIFY_API_KEY=""

# Límite de peticiones/min por IP a las server actions de geocodificación
# (protección contra abuso · docs §37). Default 30.
GEOCODING_RATE_LIMIT="30"

# ------------------------------------------------------------
# F4.7 · Automatizaciones: secreto para el endpoint /api/cron/automatizaciones
# (llamar con Authorization: Bearer $CRON_SECRET desde un cron diario)
CRON_SECRET=

# Rate limiting distribuido (Upstash Redis · opcional pero recomendado en producción)
# Sin estas variables se usa un límite local por instancia (suficiente en dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Pasarela de pago CardNET — TOKENIZACIÓN HOSPEDADA (activa) ───────────────
# La tarjeta se digita en un IFRAME de CardNET; a nosotros solo nos llega un
# TOKEN. El número de tarjeta NUNCA pasa por este servidor (PCI SAQ A). Sin
# estas dos llaves la pasarela no se ofrece, aunque la capacidad PAGO_CARDNET
# esté encendida — así una capacidad activada por error no deja una pantalla
# rota. Ver docs/PAGOS-CARDNET.md.
#
# Llave PÚBLICA: va al navegador (abre el iframe). Es normal que se vea.
CARDNET_TOKENS_PUBLIC_KEY=
# Llave PRIVADA: header Authorization del cobro. SECRETO — nunca en la base ni
# en logs ni en el navegador. Quien la tenga puede cobrar a tu nombre.
CARDNET_TOKENS_PRIVATE_KEY=
# 'pruebas' (por defecto) | 'produccion'
CARDNET_TOKENS_AMBIENTE=pruebas
#
# CardNET entrega DOS juegos de llaves de QA y NO son intercambiables:
#   · CON autenticación (3DS): la tarjeta de prueba pide la clave del reto.
#   · SIN autenticación:       cobra directo, sin reto.
# El juego decide el comportamiento del cobro, así que hay que saber cuál está
# puesto antes de interpretar un rechazo. Pídelos a tu ejecutivo de cuenta —
# NO se versionan aquí: la llave privada cobra a tu nombre.
#
# Base de la API REST (manual §11). Se deja vacío salvo que CardNET mueva el
# servicio; por defecto se usan los hosts oficiales del manual.
#   · Pruebas:    https://lab.cardnet.com.do/servicios/tokens/v1/api
#   · Producción: https://servicios.cardnet.com.do/servicios/tokens/v1/api
CARDNET_TOKENS_API_BASE=
#
# ── Integración DIRECTA 3DS (SAQ D) — EN PAUSA, no usar ─────────────────────
# Se construyó antes de migrar a la tokenización hospedada. Se conserva por si
# se necesitara, pero el flujo activo es el de tokens de arriba. Dejar vacío.
CARDNET_MERCHANT_ID=
CARDNET_TERMINAL_ID=
CARDNET_INTEGRATOR_CODE=
CARDNET_API_KEY=
CARDNET_AMBIENTE=pruebas

# ── Cola de trabajos en segundo plano (Upstash QStash) ──────────────────────
# Sin estas variables los trabajos se ejecutan DENTRO del request: no se
# pierden, pero vuelve el riesgo de agotar el tiempo de la función con envíos
# masivos. Ver docs/COLAS.md.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Opcional: a dónde debe devolver la llamada QStash. Si falta se usa
# NEXT_PUBLIC_APP_URL o el dominio de producción de Vercel.
QSTASH_TARGET_URL=

# ── MODO MANTENIMIENTO (Fase 5 · recuperación ante desastres) ────────────────
# Cierra la aplicación entera para poder restaurar o migrar sin que nadie
# escriba. Es el paso 0 de todos los runbooks de restauración: restaurar
# mientras la app acepta escrituras produce una mezcla de datos que después no
# se puede desenredar. Ver docs/runbooks/modo-mantenimiento.md.
#
# Solo "true" o "1" lo encienden. Vacío, "false" o cualquier otro valor lo
# dejan APAGADO — a propósito: una variable con un valor raro no puede tirar
# MembeGo.
MODO_MANTENIMIENTO="false"

# Pase para seguir usando la app mientras está cerrada, con `/?pase=<valor>`.
# Se guarda en una cookie de 2 horas y permite verificar la restauración antes
# de reabrir.
#
# DEBE SER DISTINTO DE BOOTSTRAP_SECRET. Este pase viaja al navegador: es un
# secreto que se expone a propósito. Si fuera el mismo que autoriza
# /api/bootstrap-superadmin, filtrarlo pasaría de "alguien puede usar la app
# cerrada" a "alguien puede crear un superadministrador".
#
# Mínimo 16 caracteres; uno más corto se ignora y no habrá puerta (fail-closed).
# Genéralo con: openssl rand -base64 32
MANTENIMIENTO_PASE=

# ── VERIFICACIÓN DE RESPALDOS (solo para correr el simulacro a mano) ─────────
# `npm run respaldo:verificar` vuelca la base de ORIGEN, la restaura en DESTINO
# y comprueba que lo restaurado sirve (datos + credenciales de auth + esquema).
# En CI lo hace solo cada lunes: .github/workflows/respaldo-verificacion.yml
#
# ORIGEN  = la DIRECT_URL de producción (puerto 5432). Solo se lee.
# DESTINO = una base VACÍA y desechable. SE SOBRESCRIBE ENTERA — nunca apuntes
#           esto a producción (el script se niega si coinciden).
RESPALDO_ORIGEN=
RESPALDO_DESTINO=

# ── OBSERVABILIDAD (Fase 6) ─────────────────────────────────────────────────
# Secreto para GET /api/metricas (cabecera x-metricas-secret). Ese endpoint
# devuelve métricas de NEGOCIO —clientes nuevos, cobros, empresas activas—, así
# que no puede ser público como /api/health: sería la curva de crecimiento de
# MembeGo a disposición de cualquiera.
#
# Mínimo 16 caracteres. Sin definir, el endpoint responde 503 y no consulta
# nada (fail-closed). Genéralo con: openssl rand -base64 32
METRICAS_SECRET=

# ── PLATAFORMA · API v1 PARA SISTEMAS VERTICALES (Fase 2) ───────────────────
# Clave con la que se firman los tokens de acceso de /api/platform/v1 (OAuth2
# client credentials). Es la puerta por la que un sistema satélite —Restaurant,
# Salon, Gym— consulta clientes, membresías y elegibilidad de beneficios.
#
# NO tiene valor por defecto y NO se deriva de ninguna otra clave. Sin definir,
# la API responde 503 y no emite ni acepta un solo token (fail-closed). Un
# default débil aquí sería la diferencia entre «la API está apagada» y «la API
# está encendida y cualquiera puede fabricarse un token» — y solo una de esas
# dos se nota desde fuera.
#
# Mínimo 32 caracteres. Genérala con: openssl rand -base64 48
# Rotarla invalida todos los tokens vivos (caducan en 15 min de todas formas);
# NO invalida las credenciales de los satélites, que viven en la base.
PLATFORM_TOKEN_SECRET=

# Clave PRIVADA Ed25519 con la que se firman los eventos salientes hacia los
# sistemas satélite (cabecera X-Membego-Signature).
#
# POR QUÉ, EN UNA FRASE: con el HMAC compartido, quien puede verificar puede
# falsificar — cada satélite guarda el mismo secreto con el que firmamos, así
# que un volcado de su base permite fabricar eventos que MembeGo parecería haber
# emitido. Ed25519 parte las dos cosas: nosotros la privada, ellos la pública.
#
# Sin definir NO se rompe nada: los eventos siguen saliendo con la firma HMAC de
# siempre. Mientras las dos viajen juntas, cada satélite migra cuando puede.
#
# Genérala con:
#   openssl genpkey -algorithm ed25519 | base64 -w0
# La pública se publica en GET /api/platform/v1/.well-known/keys
PLATFORM_EVENT_PRIVATE_KEY=
